          <div class="card-heading">
            <h2>Armour & Shields</h2>
            {{#if editable}}
              <div class="button-group compact">
                <button type="button" data-action="addFromPicker" data-slot="armour" data-tooltip="Add from Compendium">
                  <i class="fa-solid fa-magnifying-glass"></i> Armour
                </button>
                <button type="button" data-action="itemCreate" data-item-type="armour" data-tooltip="Create Blank">
                  <i class="fa-solid fa-plus"></i>
                </button>
                <button type="button" data-action="addFromPicker" data-slot="shield" data-tooltip="Add from Compendium">
                  <i class="fa-solid fa-magnifying-glass"></i> Shield
                </button>
                <button type="button" data-action="itemCreate" data-item-type="shield" data-tooltip="Create Blank">
                  <i class="fa-solid fa-plus"></i>
                </button>
              </div>
            {{/if}}
          </div>
          <div class="item-list-header inventory-header">
            <span>Name</span><span>Type</span><span>DR</span><span>Wt.</span><span></span>
          </div>
          {{#each itemGroups.armour as |item|}}
            <div class="item-row inventory-row" data-item-id="{{item.id}}">
              <button type="button" class="item-name" data-action="itemEdit">
                <img src="{{item.img}}" alt="">
                <strong>{{item.name}}</strong>
                {{#if item.notProficient}}
                  {{!-- Shown on the exception, not the rule: a badge on
                        every row is wallpaper. The tooltip carries the
                        reason, so the -4 on the roll has an explanation
                        on the sheet that produced it. --}}
                  <span class="not-proficient-badge" data-tooltip="Not proficient — {{item.proficiencyWhy}}. Attacks take -4; armour check penalties are doubled.">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                  </span>
                {{/if}}
              </button>
              <span>Armour</span>
              <span>{{item.system.dr}}</span>
              <span>{{item.system.totalWeight}}</span>
              <div class="item-controls">
                <button type="button" data-action="toggleItemEquipped" data-tooltip="{{#if item.system.equipped}}Worn — click to remove{{else}}Not worn — click to wear{{/if}}">
                  <i class="fa-solid fa-shirt{{#unless item.system.equipped}} muted-icon{{/unless}}"></i>
                </button>
                <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
                {{#if ../editable}}
                  <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
                {{/if}}
              </div>
            </div>
          {{/each}}
          {{#each itemGroups.shields as |item|}}
            <div class="item-row inventory-row" data-item-id="{{item.id}}">
              <button type="button" class="item-name" data-action="itemEdit">
                <img src="{{item.img}}" alt="">
                <strong>{{item.name}}</strong>
                {{#if item.notProficient}}
                  {{!-- Shown on the exception, not the rule: a badge on
                        every row is wallpaper. The tooltip carries the
                        reason, so the -4 on the roll has an explanation
                        on the sheet that produced it. --}}
                  <span class="not-proficient-badge" data-tooltip="Not proficient — {{item.proficiencyWhy}}. Attacks take -4; armour check penalties are doubled.">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                  </span>
                {{/if}}
              </button>
              <span>Shield</span>
              <span>{{item.system.dr}}</span>
              <span>{{item.system.totalWeight}}</span>
              <div class="item-controls">
                {{#if item.isBuckler}}
                  <button type="button" data-action="toggleShieldArm" data-tooltip="{{#if item.shieldArmInUse}}Shield arm is in use — {{item.bucklerPenalty}} to attack and no DB from the buckler. Click to free it.{{else}}Shield arm free — the buckler gives its full DB. Click if you are using a weapon with it.{{/if}}">
                    <i class="fa-solid {{#if item.shieldArmInUse}}fa-hand-fist{{else}}fa-shield{{/if}}"></i>
                  </button>
                {{/if}}
                <button type="button" data-action="toggleItemEquipped" data-tooltip="{{#if item.system.equipped}}Equipped — click to unequip{{else}}Not equipped — click to equip{{/if}}">
                  <i class="fa-solid fa-shield{{#unless item.system.equipped}} muted-icon{{/unless}}"></i>
                </button>
                <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
                {{#if ../editable}}
                  <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
                {{/if}}
              </div>
            </div>
          {{/each}}
        </article>

        <article class="ornate-card item-section">
          <div class="card-heading">
            <h2>Gear</h2>
            {{#if editable}}
              <button type="button" data-action="addFromPicker" data-slot="gear" data-tooltip="Add from Compendium">
                <i class="fa-solid fa-magnifying-glass"></i>
              </button>
              <button type="button" data-action="itemCreate" data-item-type="gear" data-tooltip="Create Blank">
                <i class="fa-solid fa-plus"></i>
              </button>
            {{/if}}
          </div>
          {{#each chargedItemWarnings as |warning|}}
            <p class="hint duplicate-slot-warning">
              <i class="fa-solid fa-triangle-exclamation"></i> {{warning}}
            </p>
          {{/each}}
          <div class="item-list-header inventory-header">
            <span>Name</span><span>Qty.</span><span>Price</span><span>Wt.</span><span></span>
          </div>
          {{#each itemGroups.gear as |item|}}
            <div class="item-row inventory-row" data-item-id="{{item.id}}">
              <button type="button" class="item-name" data-action="itemEdit">
                <img src="{{item.img}}" alt="">
                {{#if item.chargedMaxPP}}
                  {{!-- The sheet's own name-plus-secondary-line idiom, as
                        used by spells and afflictions. A pill beside the
                        name pushed "Rod of Extension III" into an
                        ellipsis. --}}
                  <span>
                    <strong>{{item.name}}</strong>
                    <small class="charge-line{{#if item.chargedEmpty}} charge-empty{{/if}}" data-tooltip="Power points held by the item — regains {{item.chargedRecharge}} per day while invested (Chapter 11)">{{item.chargedPP}}/{{item.chargedMaxPP}} PP · regains {{item.chargedRecharge}}/day</small>
                  </span>
                {{else}}
                  <strong>{{item.name}}</strong>
                {{/if}}
              </button>
              <span>{{item.system.quantity}}</span>
              <span>{{item.system.price}}</span>
              <span>{{item.system.totalWeight}}</span>
              <div class="item-controls">
                <button type="button" data-action="toggleItemEquipped" data-tooltip="{{#if item.system.equipped}}Equipped — click to unequip{{else}}Not equipped — click to equip{{/if}}">
                  <i class="fa-solid fa-hand-fist{{#unless item.system.equipped}} muted-icon{{/unless}}"></i>
                </button>
                <button type="button" data-action="toggleItemStowed" data-tooltip="{{#if item.system.stowed}}Stowed in a Stash Sack — click to take out{{else}}Stow in a Stash Sack (its weight stops counting){{/if}}">
                  <i class="fa-solid fa-sack-xmark{{#unless item.system.stowed}} muted-icon{{/unless}}"></i>
                </button>
                {{#if item.isLightSource}}
                  <button type="button" data-action="toggleItemLit" data-tooltip="{{#if item.isLit}}Lit — click to put out{{else}}Not lit — click to light it (must also be equipped to shed light){{/if}}">
                    <i class="fa-solid fa-fire{{#unless item.isLit}} muted-icon{{/unless}}"></i>
                  </button>
                  {{#if item.hasHood}}
                    <button type="button" data-action="toggleItemHood" data-tooltip="{{#if item.isHooded}}Hood lowered — still burning, shedding no light. Click to raise it{{else}}Hood raised — click to lower it and conceal the light without putting it out{{/if}}">
                      <i class="fa-solid {{#if item.isHooded}}fa-eye-slash{{else}}fa-eye muted-icon{{/if}}"></i>
                    </button>
                  {{/if}}
                {{/if}}
                {{#if item.goodsUse}}
                  <button type="button" data-action="useGoods" data-tooltip="{{item.goodsUse}}">
                    <i class="fa-solid fa-hand-sparkles"></i>
                  </button>
                {{/if}}
                {{#if item.hasInvested}}
                  <button type="button" data-action="investItem" data-tooltip="{{#if item.system.invested}}End Investment{{else}}Invest Item{{/if}} (Chapter 11)">
                    <i class="fa-solid {{#if item.system.invested}}fa-link{{else}}fa-link-slash{{/if}}"></i>
                  </button>
                {{/if}}
                {{#if item.hasFormulae}}
                  <button type="button" data-action="addFormula" data-tooltip="Add Formula (Chapter 6) — costs 10% of the item's own price">
                    <i class="fa-solid fa-scroll"></i>
                  </button>
                {{/if}}
                <button type="button" data-action="activateItem" data-tooltip="Activate Item">
                  <i class="fa-solid fa-bolt"></i>
                </button>
                <button type="button" data-action="damageItem" data-tooltip="Apply Damage to this Item (Chapter 6)">
                  <i class="fa-solid fa-hammer-crash"></i>
                </button>
                <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
                {{#if ../editable}}
                  <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
                {{/if}}
              </div>
            </div>
          {{else}}
            <div class="empty-state compact"><p>No gear.</p></div>
          {{/each}}
        </article>

        <article class="ornate-card item-section">
          <div class="card-heading">
            <h2>Consumables & Ammunition</h2>
            {{#if editable}}
              <div class="button-group compact">
                <button type="button" data-action="addFromPicker" data-slot="consumable" data-tooltip="Add from Compendium">
                  <i class="fa-solid fa-magnifying-glass"></i> Consumable
                </button>
                <button type="button" data-action="itemCreate" data-item-type="consumable" data-tooltip="Create Blank">
                  <i class="fa-solid fa-plus"></i>
                </button>
                <button type="button" data-action="addFromPicker" data-slot="ammunition" data-tooltip="Add from Compendium">
                  <i class="fa-solid fa-magnifying-glass"></i> Ammunition
                </button>
                <button type="button" data-action="addFromPicker" data-slot="alchemical" data-tooltip="Add from Compendium — elixirs, herbs, oils, poisons and vials (Chapter 6)">
                  <i class="fa-solid fa-magnifying-glass"></i> Alchemical
                </button>
                <button type="button" data-action="itemCreate" data-item-type="ammunition" data-tooltip="Create Blank">
                  <i class="fa-solid fa-plus"></i>
                </button>
              </div>
            {{/if}}
          </div>
          <div class="item-list-header inventory-header">
            <span>Name</span><span>Type</span><span>Qty.</span><span>Wt.</span><span></span>
          </div>
          {{#each itemGroups.consumables as |item|}}
            <div class="item-row inventory-row" data-item-id="{{item.id}}">
              <button type="button" class="item-name" data-action="itemEdit">
                <img src="{{item.img}}" alt="">
                <span>
                  <strong>{{item.name}}</strong>
                  {{#if item.bombLine}}
                    <small class="charge-line" data-tooltip="Thrown as a martial weapon, range increment {{item.bombRange}} ft (Chapter 6)">{{item.bombLine}}</small>
                  {{/if}}
                  {{#if item.consumableLine}}
                    <small class="charge-line" data-tooltip="What this releases when used, and at what PP (Chapter 11)">{{item.consumableLine}}</small>
                  {{/if}}
                </span>
              </button>
              <span>{{#if item.alchemicalSection}}{{item.alchemicalSection}}{{else if item.consumableLabel}}{{item.consumableLabel}}{{else}}Consumable{{/if}}</span>
              <span>{{item.system.quantity}}</span>
              <span>{{item.system.totalWeight}}</span>
              <div class="item-controls">
                {{#if item.canUseConsumable}}
                  <button type="button" data-action="useConsumable" data-tooltip="{{item.consumableVerb}} it{{#if item.consumableSpell}} — releases {{item.consumableSpell}}{{else}} — nothing is recorded on it, so its description is read out instead{{/if}}">
                    <i class="fa-solid fa-wand-sparkles{{#if item.consumableNeedsSpell}} muted-icon{{/if}}"></i>
                  </button>
                {{/if}}
                {{#if item.isBomb}}
                  <button type="button" data-action="throwBomb" data-tooltip="Throw it — an attack as a martial thrown weapon, {{item.bombRange}} ft range increment">
                    <i class="fa-solid fa-fire-flame-curved"></i>
                  </button>
                {{/if}}
                {{#if item.canCraftHigher}}
                  <button type="button" data-action="craftAtLevel" data-tooltip="Craft this at a higher level — its effect and price both climb (Chapter 6)">
                    <i class="fa-solid fa-arrow-up-right-dots"></i>
                  </button>
                {{/if}}
                <button type="button" data-action="toggleItemEquipped" data-tooltip="{{#if item.system.equipped}}Held, ready to use — click to put away{{else}}Not held — click to hold ready{{/if}}">
                  <i class="fa-solid fa-hand-fist{{#unless item.system.equipped}} muted-icon{{/unless}}"></i>
                </button>
                <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
                {{#if ../editable}}
                  <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
                {{/if}}
              </div>
            </div>
          {{/each}}
          {{#each itemGroups.ammunition as |item|}}
            <div class="item-row inventory-row" data-item-id="{{item.id}}">
              <button type="button" class="item-name" data-action="itemEdit">
                <img src="{{item.img}}" alt=""><strong>{{item.name}}</strong>
              </button>
              <span>Ammunition</span>
              <span>{{item.system.quantity}}</span>
              <span>{{item.system.totalWeight}}</span>
              <div class="item-controls">
                <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
                {{#if ../editable}}
                  <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
                {{/if}}
              </div>
            </div>
          {{/each}}
        </article>
      </div>
    </section>

    <section
      class="tab sheet-tab-panel {{tabs.magicItems.cssClass}}"
      data-group="primary"
      data-tab="magicItems"
    >
      <div class="section-heading">
        <div>
          <span class="eyebrow">Charged, wondrous, and specific</span>
          <h2>Magic Items</h2>
        </div>
        {{#if editable}}
          <button type="button" class="gold-button" data-action="buildMagicItem"
            data-tooltip="Build a magic item from Chapter 11's construction rules — priced and levelled as you choose">
            <i class="fa-solid fa-hammer"></i> Build
          </button>
        {{/if}}
        <div class="encumbrance-badge{{#if investment.over}} investment-over{{/if}}"
          data-tooltip="{{#if investment.over}}Over the Chapter 11 investment limit — some of these items should not be granting their benefits{{else}}Items invested, against your limit (Chapter 11){{/if}}">
          <i class="fa-solid {{#if investment.over}}fa-triangle-exclamation{{else}}fa-link{{/if}}"></i>
          <span>{{investment.used}} / {{investment.max}} invested</span>
        </div>
      </div>

      <div class="inventory-columns">
        <article class="ornate-card item-section">
          <div class="card-heading">
            <h2>Charged Items</h2>
            {{#if editable}}
              <button type="button" data-action="addFromPicker" data-slot="chargedItem" data-tooltip="Add from Compendium">
                <i class="fa-solid fa-magnifying-glass"></i>
              </button>
            {{/if}}
          </div>
          {{#each chargedItemWarnings as |warning|}}
            <p class="hint duplicate-slot-warning">
              <i class="fa-solid fa-triangle-exclamation"></i> {{warning}}
            </p>
          {{/each}}
          <div class="item-list-header inventory-header">
            <span>Name</span><span>Charge</span><span>Price</span><span>Wt.</span><span></span>
          </div>
          {{#each itemGroups.chargedItems as |item|}}
            <div class="item-row inventory-row" data-item-id="{{item.id}}">
              <button type="button" class="item-name" data-action="itemEdit">
                <img src="{{item.img}}" alt="">
                <span>
                  <strong>{{item.name}}</strong>
                  {{#if item.chargedSpells}}
                    <small class="charge-line">{{item.chargedSpells}}</small>
                  {{/if}}
                </span>
              </button>
              <span class="charge-line{{#if item.chargedEmpty}} charge-empty{{/if}}"
                data-tooltip="Power points held by the item — regains {{item.chargedRecharge}} per day while invested (Chapter 11)">{{item.chargedPP}}/{{item.chargedMaxPP}} PP</span>
              <span>{{item.system.price}}</span>
              <span>{{item.system.totalWeight}}</span>
              <div class="item-controls">
                <button type="button" data-action="toggleItemEquipped" data-tooltip="{{#if item.system.equipped}}Held — click to stow{{else}}Stowed — click to hold{{/if}}">
                  <i class="fa-solid fa-hand-fist{{#unless item.system.equipped}} muted-icon{{/unless}}"></i>
                </button>
                {{#if item.hasInvested}}
                  <button type="button" data-action="investItem" data-tooltip="{{#if item.system.invested}}End Investment{{else}}Invest Item{{/if}} (Chapter 11)">
                    <i class="fa-solid {{#if item.system.invested}}fa-link{{else}}fa-link-slash{{/if}}"></i>
                  </button>
                {{/if}}
                <button type="button" data-action="activateItem" data-tooltip="Cast a Spell from this item (Chapter 11)">
                  <i class="fa-solid fa-bolt"></i>
                </button>
                <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
                {{#if ../editable}}
                  <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
                {{/if}}
              </div>
            </div>
          {{else}}
            <div class="empty-state compact"><p>No rods, staves or wands.</p></div>
          {{/each}}
        </article>

        <article class="ornate-card item-section">
          <div class="card-heading">
            <h2>Wondrous Items</h2>
            {{#if editable}}
              <button type="button" data-action="addFromPicker" data-slot="wondrous" data-tooltip="Add from Compendium">
                <i class="fa-solid fa-magnifying-glass"></i>
              </button>
            {{/if}}
          </div>
          <p class="hint">
            A wondrous item's benefits apply while it is <strong>invested and worn</strong> (Chapter 11); a Stash Sack needs only its investment.
          </p>
          {{#each system.combat.wondrousProblems as |problem|}}
            <p class="hint duplicate-slot-warning">
              <i class="fa-solid fa-triangle-exclamation"></i> {{problem}}
            </p>
          {{/each}}
          <div class="item-list-header inventory-header">
            <span>Name</span><span>Slot</span><span>Price</span><span>Wt.</span><span></span>
          </div>
          {{#each itemGroups.wondrousItems as |item|}}
            <div class="item-row inventory-row" data-item-id="{{item.id}}">
              <button type="button" class="item-name" data-action="itemEdit">
                <img src="{{item.img}}" alt="">
                <span>
                  <strong>{{item.name}}</strong>
                  {{#if item.wondrousAbilities.length}}
                    <small class="charge-line{{#unless item.wondrousActive}} charge-empty{{/unless}}"
                      data-tooltip="{{#if item.wondrousActive}}Applied to the sheet now{{else}}Invest and wear the item to gain these{{/if}}">{{#each item.wondrousAbilities as |ability|}}{{#unless @first}}, {{/unless}}{{ability}}{{/each}}</small>
                  {{/if}}
                </span>
              </button>
              <span>{{item.wondrousSlot}}</span>
              <span>{{item.system.price}}</span>
              <span>{{item.system.totalWeight}}</span>
              <div class="item-controls">
                <button type="button" data-action="toggleItemEquipped" data-tooltip="{{#if item.system.equipped}}Worn — click to stow{{else}}Stowed — click to wear{{/if}}">
                  <i class="fa-solid fa-hand-fist{{#unless item.system.equipped}} muted-icon{{/unless}}"></i>
                </button>
                {{#if item.hasInvested}}
                  <button type="button" data-action="investItem" data-tooltip="{{#if item.system.invested}}End Investment — its benefits stop{{else}}Invest Item — its benefits begin (Chapter 11){{/if}}">
                    <i class="fa-solid {{#if item.system.invested}}fa-link{{else}}fa-link-slash{{/if}}"></i>
                  </button>
                {{/if}}
                <button type="button" data-action="activateItem" data-tooltip="{{#if item.wondrousUse}}{{item.wondrousUse}}{{else}}Activate Item{{/if}}">
                  <i class="fa-solid {{#if item.wondrousUse}}fa-hand-holding-medical{{else}}fa-bolt{{/if}}"></i>
                </button>
                <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
                {{#if ../editable}}
                  <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
                {{/if}}
              </div>
            </div>
          {{else}}
            <div class="empty-state compact"><p>No wondrous items.</p></div>
          {{/each}}
        </article>
      </div>

      {{#if system.combat.wondrousReported.length}}
        <article class="ornate-card item-section">
          <div class="card-heading">
            <h2>Applied by hand</h2>
          </div>
          <p class="hint">
            What your invested wondrous items do that this system does not model for you.
          </p>
          {{#each system.combat.wondrousReported as |note|}}
            <p class="hint"><i class="fa-solid fa-circle-info"></i> {{note}}</p>
          {{/each}}
        </article>
      {{/if}}

      <article class="ornate-card item-section">
        <div class="card-heading">
          <h2>Specific Armour &amp; Weapons</h2>
          {{#if editable}}
            <button type="button" data-action="addFromPicker" data-slot="specificItem" data-tooltip="Add from Compendium">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          {{/if}}
        </div>
        <p class="hint">
          Named magical armour, shields and weapons. They are armour and weapons, so they appear
          in the <strong>Items</strong> tab's own tables once added.
        </p>
      </article>
    </section>

    <section
      class="tab sheet-tab-panel {{tabs.magic.cssClass}}"
      data-group="primary"
      data-tab="magic"
    >
      <div class="section-heading">
        <div>
          <span class="eyebrow">Tradition, power, and spellcraft</span>
          <h2>Magic</h2>
        </div>
        <div class="heading-actions">
          <button type="button" class="gold-button" data-action="rollSpellConcentration">
            <i class="fa-solid fa-om"></i> Spell Concentration
          </button>
          <button type="button" class="gold-button" data-action="rollPowerPointRecovery">
            <i class="fa-solid fa-battery-half"></i> PP Recovery
          </button>
          <button type="button" class="gold-button" data-action="rollDisbelieveIllusion">
            <i class="fa-solid fa-eye-slash"></i> Disbelieve Illusion
          </button>
        </div>
        {{#if editable}}
          <button type="button" class="gold-button" data-action="addFromPicker" data-slot="spell">
            <i class="fa-solid fa-magnifying-glass"></i> Add from Compendium
          </button>
          <button type="button" class="gold-button" data-action="itemCreate" data-item-type="spell">
            <i class="fa-solid fa-plus"></i> Add Spell
          </button>
        {{/if}}
      </div>

      <article class="ornate-card magic-summary">
        <div class="field-grid six-column">
          {{! A caster class FIXES both of these — "you draw your spells
              from the verdant tradition" is not a choice — so they read
              out rather than offering a control that submits the derived
              value straight back into storage. The sheet submits on every
              change, so an editable select here meant a Ranger's verdant
              was written into _source and survived the class being
              removed. }}
          <label>
            <span>Tradition</span>
            {{#if system.progression.tradition}}
              <output data-tooltip="Fixed by your class — {{system.progression.source}} draws its spells from the {{system.progression.tradition}} tradition.">{{system.magic.tradition}}</output>
            {{else}}
              <select name="system.magic.tradition" data-tooltip="Setting a tradition automatically sets Casting Attribute to match (Chapter 9). Leave blank to set Casting Attribute manually.">
                {{selectOptions traditionChoices selected=system.magic.tradition}}
              </select>
            {{/if}}
          </label>
          <label>
            <span>Casting Attribute</span>
            {{#if castingAbilityFixed}}
              <output data-tooltip="{{castingAbilityWhy}}">{{system.magic.castingAbility}}</output>
            {{else}}
              <select name="system.magic.castingAbility">
                {{selectOptions abilityChoices selected=system.magic.castingAbility}}
              </select>
            {{/if}}
          </label>
          <label>
            <span>Caster Level</span>
            {{#if casterLevelFixed}}
              <output data-tooltip="{{casterLevelWhy}}">{{system.magic.casterLevelValue}}</output>
            {{else}}
              <input type="number" name="system.magic.casterLevel" value="{{system.magic.casterLevel}}" min="0" data-tooltip="Caster level for spell scaling (Chapter 9). 0 = take it from your class table, or from your character level if your class has none. Anything else overrides both. Resolved: {{system.magic.casterLevelValue}} (from {{system.magic.casterLevelSource}}).">
            {{/if}}
          </label>
          <label>
            <span>BSB</span>
            {{#if bsbFixed}}
              <output data-tooltip="{{bsbWhy}}">{{bsbValue}}</output>
            {{else}}
              <input type="number" name="system.magic.bsb" value="{{system.magic.bsb}}" data-tooltip="Your Base Spellcraft Bonus. A class supplies this from its own table; this field is what you have on top of that.">
            {{/if}}
          </label>
          <label>
            <span>Base Power Points</span>
            <input type="number" name="system.resources.pp.base" value="{{system.resources.pp.base}}" min="0" data-tooltip="Your own base maximum PP, before your class and your magical ability score. This is what racial power points, Aura of Power and the Knight feats write into. Resolved maximum: {{system.resources.pp.max}}.">
          </label>
          <label>
            <span>Spellcraft DC</span>
            <output>{{system.magic.spellcraft.dc}}</output>
          </label>
          <label>
            <span>Spellcraft</span>
            <button type="button" class="output-button" data-action="rollSpellcraft">
              <strong>{{system.magic.spellcraft.total}}</strong>
              <i class="fa-solid fa-dice-d20"></i>
            </button>
          </label>
          <label>
            <span>Casting Focus</span>
            <input type="text" name="system.magic.focus" value="{{system.magic.focus}}" placeholder="wand, staff, holy symbol…" data-tooltip="The focus item this caster channels through (name it here). Casting Focus is a permanent choice made at character creation.">
          </label>
          <div class="two-checkbox-field">
            <span>Focus</span>
            <div class="two-checkbox-row">
              <label data-tooltip="This caster casts with a focus (Chapter 9): +1 item bonus to casting while the focus is in hand, but -2 circumstance (and +10 to any Fumble roll) when casting without it. The held focus also stands in for a somatic component.">
                <input type="checkbox" name="system.magic.focusCasting" {{checked system.magic.focusCasting}}>
                <span>Caster</span>
              </label>
              <label data-tooltip="Whether the focus is currently held and usable. Untick if the focus is lost, stowed, or otherwise unavailable — casting then takes the -2 circumstance penalty and the +10 fumble danger.">
                <input type="checkbox" name="system.magic.focusReady" {{checked system.magic.focusReady}}>
                <span>In hand</span>
              </label>
            </div>
          </div>
          <label>
            <span>Control Levels</span>
            <output data-tooltip="Chapter 9: the total creature levels you can control at once = character level + magical ability modifier + a per-level class bonus. If you exceed this, your highest-level controlled creature makes a DC 20 Will save each round to break free.">{{system.magic.controlLevelsUsed}} / {{system.magic.controlLevels}}</output>
          </label>
          <label>
            <span>Control bonus / level</span>
            <input type="number" name="system.magic.controlBonusPerLevel" value="{{system.magic.controlBonusPerLevel}}" min="0" max="2" data-tooltip="The per-level class bonus to Control Levels: Cleric / Druid / Wizard = 1; Wizard (Conjurer / Enchanter) = 2; other classes = 0. Still set by hand — the caster classes have not been built yet.">
          </label>
          <label>
            <span>Controlled (levels)</span>
            <input type="number" name="system.magic.controlLevelsUsed" value="{{system.magic.controlLevelsUsed}}" min="0" data-tooltip="Total levels of creatures you currently control. When this exceeds your Control Levels, the highest-level controlled creature can attempt a DC 20 Will save each round to release itself.">
          </label>
        </div>
        <div class="spellcraft-breakdown">
          <label><span>Ability</span><output>{{system.magic.spellcraft.ability}}</output></label>
          <label><span>Racial</span><input type="number" name="system.magic.spellcraft.racial" value="{{system.magic.spellcraft.racial}}"></label>
          <label><span>Class</span><input type="number" name="system.magic.spellcraft.class" value="{{system.magic.spellcraft.class}}"></label>
          <label><span>Item</span><input type="number" name="system.magic.spellcraft.item" value="{{system.magic.spellcraft.item}}"></label>
          <label><span>Status</span><input type="number" name="system.magic.spellcraft.status" value="{{system.magic.spellcraft.status}}"></label>
          <label><span>Other</span><input type="number" name="system.magic.spellcraft.other" value="{{system.magic.spellcraft.other}}"></label>
        </div>
      </article>

      {{!-- SPELL STORING (3.495.0). Its own card rather than a row in the
            Active Spells list: the entry there belongs to Spell Storing
            itself, which is PP-locked until daily preparations, while
            this is a different spell sitting in a different object. --}}
      {{#if storedSpell}}
      <article class="ornate-card stored-spell">
        <div class="item-list-header">
          <span>Stored Spell</span>
          <span>PP</span>
          <span>In</span>
          <span></span>
        </div>
        <div class="item-row">
          <span>{{storedSpell.name}}</span>
          <span>{{storedSpell.ppPaid}}</span>
          <span>{{storedSpell.itemName}}</span>
          <span class="spell-actions">
            <button type="button" data-action="releaseStoredSpell"
              data-tooltip="Release the stored spell ({{storedSpell.releaseLabel}}) — its targets, check and saves resolve now"><i class="fa-solid fa-wand-sparkles"></i></button>
          </span>
        </div>
        <p class="hint" style="padding:4px 8px">Paid for at storage; releasing settles the difference against the degree rolled.</p>
      </article>
      {{/if}}

      {{#if activeSpells.length}}
      <article class="ornate-card active-spells">
        <div class="item-list-header">
          <span>Active Spell</span>
          <span>PP</span>
          <span>State</span>
          <span></span>
        </div>
        {{#each activeSpells as |spell|}}
          <div class="item-row" data-spell-id="{{spell.id}}">
            <span>{{spell.name}}</span>
            <span>{{#if spell.lock}}{{spell.pp}} 🔒{{else}}—{{/if}}</span>
            {{!-- One string, computed in active-spells.mjs. The two-way
                  branch that lived here printed "PP locked ()" over any
                  entry that was neither sustained nor locked, which is
                  every (D) spell from 3.494.0 on. --}}
            <span>{{spell.state}}</span>
            <span class="spell-actions">
              {{#if spell.sustained}}<button type="button" data-action="sustainSpell" data-spell-id="{{spell.id}}" data-tooltip="Sustain — continue until the end of your next turn"><i class="fa-solid fa-rotate-right"></i></button>{{/if}}
              {{!-- Umbral Veil's decoy. Offered only while the circle is
                    still following someone, because putting down a cloak
                    already on the floor is not a thing that happens. --}}
              {{#if spell.canDrop}}<button type="button" data-action="dropSpell" data-spell-id="{{spell.id}}" data-tooltip="Let it go (1 AP Interact) — the shadows stay where they are dropped and keep dimming for the rest of the duration"><i class="fa-solid fa-hand-sparkles"></i></button>{{/if}}
              <button type="button" data-action="endSpell" data-spell-id="{{spell.id}}" data-tooltip="Dismiss / end this spell (releases any locked PP)"><i class="fa-solid fa-xmark"></i></button>
            </span>
          </div>
        {{/each}}
        {{#if system.resources.pp.locked}}<p class="hint" style="padding:4px 8px">{{system.resources.pp.locked}} PP locked by extended-duration spells (unrecoverable until they end).</p>{{/if}}
      </article>
      {{/if}}

      {{#if repertoire}}
      <article class="ornate-card repertoire-card">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Instinctive caster — no memorisation needed</span>
            <h2>Spell Repertoire</h2>
          </div>
          {{#if editable}}
          <div class="heading-actions">
            <button type="button" class="gold-button" data-action="pickRepertoireSpell"
              data-tooltip="Add a repertoire spell — two PP 2 picks at 1st, one more at 3rd and every two levels after{{#if repertoire.category}} ({{repertoire.category}} spells only){{/if}}">
              <i class="fa-solid fa-book-medical"></i> Pick Spell
            </button>
            <button type="button" class="gold-button" data-action="swapRepertoireSpell"
              data-tooltip="Swap one repertoire spell for a new one — one swap banked at 5th and every two levels after">
              <i class="fa-solid fa-right-left"></i> Swap Spell
            </button>
          </div>
          {{/if}}
        </div>
        <div class="field-grid four-column">
          <label>
            <span>Picks</span>
            <output data-tooltip="Repertoire spells chosen against the class schedule{{#if repertoire.bonus}}, including {{repertoire.bonus}} from Magical Discovery{{/if}}{{#if repertoire.nextPickLevel}} — the next pick arrives at level {{repertoire.nextPickLevel}}{{/if}}.">{{repertoire.picked}} / {{repertoire.allowed}}</output>
          </label>
          <label>
            <span>Owed</span>
            <output data-tooltip="Picks the schedule has granted that are still unchosen.">{{repertoire.remaining}}</output>
          </label>
          <label>
            <span>Swaps left</span>
            <output data-tooltip="Banked swaps — one arrives at 5th level and every two levels after{{#if repertoire.nextSwapLevel}}; the next at level {{repertoire.nextSwapLevel}}{{/if}}.">{{repertoire.swapsLeft}} / {{repertoire.swapsAllowed}}</output>
          </label>
          <label>
            <span>Restriction</span>
            <output data-tooltip="What a pick may be: your tradition{{#if repertoire.category}}, {{repertoire.category}} spells only{{/if}}; PP 2 for the two 1st-level picks, then anything you can actually cast.">{{repertoire.tradition}}{{#if repertoire.category}} · {{repertoire.category}}{{/if}}</output>
          </label>
        </div>
      </article>
      {{/if}}

      {{#if knownCantrips}}
      <article class="ornate-card repertoire-card">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Learned once — cast at any time, no memorisation</span>
            <h2>Cantrips</h2>
          </div>
          {{#if editable}}
          <div class="heading-actions">
            <button type="button" class="gold-button" data-action="pickCantrip"
              data-tooltip="Learn a cantrip — {{knownCantrips.allowed}} chosen at 1st level from your tradition, kept permanently.">
              <i class="fa-solid fa-wand-sparkles"></i> Pick Cantrip
            </button>
          </div>
          {{/if}}
        </div>
        <div class="field-grid four-column">
          <label>
            <span>Known</span>
            <output data-tooltip="Cantrips learned against this class's permanent allowance.">{{knownCantrips.picked}} / {{knownCantrips.allowed}}</output>
          </label>
          <label>
            <span>Owed</span>
            <output data-tooltip="Cantrips the class has granted that are still unchosen.">{{knownCantrips.remaining}}</output>
          </label>
          <label>
            <span>Restriction</span>
            <output data-tooltip="What a cantrip may be: PP 0, from your own tradition.">{{knownCantrips.tradition}} · PP 0</output>
          </label>
        </div>
      </article>
      {{/if}}

      {{!-- The caster archetypes: one card each, never merged with the
            class's own pools, because a Cleric may hold Arcanist. --}}
      {{#each archetypeCasting as |arch|}}
      <article class="ornate-card repertoire-card">
        <div class="section-heading">
          <div>
            <span class="eyebrow">{{arch.printed}}</span>
            <h2>{{arch.label}} — {{arch.traditionLabel}} Cantrips</h2>
            {{#if arch.casterLevelNote}}
            <p class="archetype-caster-level-note"><em>{{arch.casterLevelNote}}</em></p>
            {{/if}}
          </div>
          {{#if ../editable}}
          <div class="heading-actions">
            {{#if arch.permanentAllowed}}
            <button type="button" class="gold-button" data-action="pickArchetypeCantrip"
              data-source="{{arch.key}}"
              data-tooltip="Choose one of the {{arch.permanentAllowed}} cantrips you keep permanently.">
              <i class="fa-solid fa-book"></i> Pick Cantrip
            </button>
            {{/if}}
            {{#if arch.prepares}}
            <button type="button" class="gold-button" data-action="prepareArchetypeCantrip"
              data-source="{{arch.key}}"
              data-tooltip="Prepare one of today's {{arch.dailyAllowed}} cantrips.">
              <i class="fa-solid fa-wand-sparkles"></i> Prepare
            </button>
            <button type="button" class="gold-button" data-action="clearArchetypeCantrips"
              data-source="{{arch.key}}"
              data-tooltip="Put today's prepared cantrips back so a different set can be chosen.">
              <i class="fa-solid fa-rotate-left"></i> Clear Prepared
            </button>
            {{/if}}
          </div>
          {{/if}}
        </div>
        <div class="field-grid four-column">
          {{#if arch.permanentAllowed}}
          <label>
            <span>{{#if arch.preparesFromBook}}Spellbook{{else}}Known{{/if}}</span>
            <output data-tooltip="Cantrips kept permanently by this archetype.">{{arch.permanentPicked}} / {{arch.permanentAllowed}}</output>
          </label>
          {{/if}}
          {{#if arch.prepares}}
          <label>
            <span>Prepared today</span>
            <output data-tooltip="Cantrips prepared for today. Clear them to choose differently.">{{arch.dailyPicked}} / {{arch.dailyAllowed}}</output>
          </label>
          {{/if}}
          <label>
            <span>Restriction</span>
            <output data-tooltip="What a cantrip may be here: PP 0, from this archetype's tradition.">{{arch.traditionLabel}} · PP 0</output>
          </label>
        </div>
        {{#if arch.blockedOnBook}}
        <p class="hint"><em>Fill the spellbook before preparing — the Arcanist prepares two of <strong>these</strong> cantrips, not any four.</em></p>
        {{/if}}
        {{#if arch.permanent.length}}
        <p class="hint"><strong>{{#if arch.preparesFromBook}}Spellbook{{else}}Known{{/if}}:</strong>
          {{#each arch.permanent as |c|}}{{c.name}}{{#unless @last}}, {{/unless}}{{/each}}</p>
        {{/if}}
        {{#if arch.daily.length}}
        <p class="hint"><strong>Prepared today:</strong>
          {{#each arch.daily as |c|}}{{c.name}}{{#unless @last}}, {{/unless}}{{/each}}</p>
        {{/if}}
      </article>
      {{/each}}

      {{!-- Feat-granted LEVELLED slots (3.345.0): a Knight feat's PP 2
            spell and any caster-tier slots, grouped by tradition. Each
            row names the feat that granted the slot and that feat's own
            PP ceiling, because one character can hold several slots at
            different ceilings in the same tradition. --}}
      {{#each featSpellSlots as |grp|}}
      <article class="ornate-card repertoire-card">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Granted by feats — one spell per slot, not a pool</span>
            <h2>{{grp.label}} Spell Slots</h2>
          </div>
        </div>
        {{#if grp.total}}
        <div class="field-grid four-column">
          <label>
            <span>Filled</span>
            <output data-tooltip="Slots holding a memorised spell.">{{grp.filled}} / {{grp.total}}</output>
          </label>
          <label>
            <span>Empty</span>
            <output data-tooltip="Slots still to fill from this card.">{{grp.empty}}</output>
          </label>
        </div>
        <table>
          <thead><tr><th>Granted by</th><th>Max PP</th><th>Spell</th><th></th></tr></thead>
          <tbody>
            {{#each grp.slots as |slot|}}
            <tr>
              <td>{{slot.grantedBy}}</td>
              <td>{{slot.maxPP}}</td>
              <td>{{#if slot.filledName}}{{slot.filledName}}{{else}}<em>empty</em>{{/if}}</td>
              <td>
                {{#if @root.editable}}
                {{#if slot.filledName}}
                <button type="button" class="gold-button" data-action="clearFeatSlotSpell"
                  data-slot="{{slot.id}}" data-tooltip="Empty this slot so a different spell can be memorised.">
                  <i class="fa-solid fa-rotate-left"></i> Clear
                </button>
                {{else}}
                <button type="button" class="gold-button" data-action="pickFeatSlotSpell"
                  data-slot="{{slot.id}}" data-tooltip="Memorise a spell of PP {{slot.maxPP}} or less in this slot.">
                  <i class="fa-solid fa-wand-sparkles"></i> Memorise
                </button>
                {{/if}}
                {{/if}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{/if}}
        {{#if grp.orphaned}}
        <p class="hint"><strong style="color:#8a1c1c">No slot:</strong>
          {{#each grp.orphaned as |o|}}{{o.name}}{{#unless @last}}, {{/unless}}{{/each}} —
          the feat that granted the slot has gone, so this cannot be cast.</p>
        {{/if}}
        {{#each grp.suppressed as |sup|}}
        <p class="hint"><strong>{{sup.name}}</strong> grants nothing —
          caster feats grant a tradition <em>different</em> from your class's,
          and {{sup.tradition}} is already yours.</p>
        {{/each}}
      </article>
      {{/each}}

      {{#if memorisation}}
      <article class="ornate-card memorisation-card">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Learned caster — memorise for the day before casting</span>
            <h2>Memorisation</h2>
          </div>
          {{#if editable}}
          <div class="heading-actions">
            <button type="button" class="gold-button" data-action="memoriseSpell"
              data-tooltip="Choose today's leveled spells{{#if memorisation.isBookStyle}} from your spell book{{/if}} — 2 + (2 x level), pre-checked with what's already memorised. Persists day to day until you change it.">
              <i class="fa-solid fa-book-medical"></i> Memorise Spell
            </button>
            <button type="button" class="gold-button" data-action="memoriseCantrip"
              data-tooltip="Choose today's cantrips — pack-wide regardless of memorisation style, pre-checked with what's already memorised. Persists day to day until you change it.">
              <i class="fa-solid fa-wand-magic-sparkles"></i> Memorise Cantrip
            </button>
          </div>
          {{/if}}
        </div>
        <div class="field-grid four-column">
          <label>
            <span>Leveled spells</span>
            <output data-tooltip="Today's leveled picks against the day's allowance (2 + 2 x level){{#if memorisation.bonus}}, including {{memorisation.bonus}} from Magical Discovery{{/if}}.">{{memorisation.leveledPicked}} / {{memorisation.leveledAllowed}}</output>
          </label>
          <label>
            <span>Owed</span>
            <output data-tooltip="Leveled slots still open today.">{{memorisation.leveledRemaining}}</output>
          </label>
          <label>
            <span>Cantrips</span>
            <output data-tooltip="Today's cantrip picks against the day's allowance.">{{memorisation.cantripsPicked}} / {{memorisation.cantripsAllowed}}</output>
          </label>
          <label>
            <span>Pool</span>
            <output data-tooltip="Where today's leveled picks come from.">{{memorisation.poolLabel}}</output>
          </label>
        </div>
        {{#if memorisation.hasGranted}}
        <div class="field-grid four-column">
          {{#each memorisation.granted}}
          <label>
            <span>{{this.label}} spells</span>
            <output data-tooltip="Granted by your Caster feats. These slots hold {{this.label}} spells only — they are not extra room in your own tradition.">{{this.picked}} / {{this.slots}}</output>
          </label>
          {{/each}}
        </div>
        <p class="hint">Your Caster feats grant spells of a <strong>different</strong> tradition, memorised in their own slots above. Spellcraft checks for those spells use that tradition's own ability score.</p>
        {{/if}}
        {{#if memorisation.isBookStyle}}
        <p class="hint">To add new spells to the book itself (rather than just memorise from it for today), open the Wizard's Spellbook item in your inventory.</p>
        {{/if}}
      </article>
      {{/if}}

      <article class="ornate-card spellbook">
        {{#if itemGroups.spells.length}}
        <div class="list-filter-row">
          <label>
            <span>Tradition</span>
            <select class="spell-filter-tradition">
              <option value="">All traditions</option>
              {{#each spellFilters.traditions}}
              <option value="{{this.value}}">{{this.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>PP</span>
            <select class="spell-filter-pp">
              <option value="">All PP</option>
              {{#each spellFilters.pps}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
          </label>
        </div>
        {{/if}}
        <div class="item-list-header spell-header">
          <span></span>
          <span>Spell</span>
          <span>Tradition</span>
          <span>PP</span>
          <span>AP</span>
          <span>Range</span>
          <span>Duration</span>
          <span>Source</span>
          <span></span>
        </div>
        {{#each itemGroups.spells as |item|}}
          <div class="item-row spell-row" data-item-id="{{item.id}}" data-tradition="{{item.system.tradition}}" data-pp="{{item.system.ppCost}}">
            <div class="spell-actions">
              <button type="button" class="cast-spell-button" data-action="castSpell" data-tooltip="Cast a Spell"><i class="fa-solid fa-wand-sparkles"></i></button>
              <button type="button" class="cast-spell-button" data-action="rollMagicRitual" data-tooltip="Magic Ritual (cooperative overcasting)"><i class="fa-solid fa-people-group"></i></button>
            </div>
            <button type="button" class="item-name" data-action="itemEdit">
              <img src="{{item.img}}" alt="">
              <span>
                <strong>{{item.name}}</strong>
                <small>{{item.system.category}}</small>
              </span>
            </button>
            <span>{{item.system.tradition}}</span>
            <span>{{item.system.ppCost}}</span>
            <span>{{item.system.castAP}}</span>
            <span>{{item.system.range}}</span>
            <span>{{item.system.duration}}</span>
            {{!-- Why this spell is castable, replacing a tick that read
                  "prepared": true for a learned caster mid-day, meaningless
                  for a Bard, and actively misleading beside a deific
                  aspect's spells. --}}
            <span class="spell-source" data-source="{{item.spellSourceKey}}"
              data-tooltip="Everything on this table can be cast. This is where it came from.">{{item.spellSource}}</span>
            <div class="item-controls">
              <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
              {{#if ../editable}}
                <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
              {{/if}}
            </div>
          </div>
        {{else}}
          <div class="empty-state">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            <p>This spellbook is empty.</p>
          </div>
        {{/each}}
      </article>

      {{#if itemGroups.innateSpells.length}}
      <article class="ornate-card spellbook innate-spellbook">
        <h2>Innate Spells</h2>
        <div class="item-list-header spell-header innate-spell-header">
          <span></span>
          <span>Spell</span>
          <span>Tradition</span>
          <span>Uses / Day</span>
          <span>Attack / Save</span>
          <span></span>
        </div>
        {{#each itemGroups.innateSpells as |item|}}
          <div class="item-row spell-row innate-spell-row" data-item-id="{{item.id}}">
            <div class="spell-actions">
              <button type="button" class="cast-spell-button" data-action="castSpell" data-tooltip="Cast Innate Spell (0 PP)"><i class="fa-solid fa-wand-sparkles"></i></button>
            </div>
            <button type="button" class="item-name" data-action="itemEdit">
              <img src="{{item.img}}" alt="">
              <span>
                <strong>{{item.name}}</strong>
                <small>{{item.system.category}} · innate</small>
              </span>
            </button>
            <span>{{item.system.tradition}}</span>
            <span class="uses-cell">
              {{#if item.usesUnlimited}}
                &infin;
              {{else if item.usesTracked}}
                <button type="button" class="uses-set" data-action="setItemUses"
                  data-tooltip="Uses left today — click to set an exact figure. A successful Refocus restores one; Daily Preparation refills it.">{{item.usesRemaining}} / {{item.usesMax}}</button>
              {{else}}&mdash;{{/if}}
            </span>
            <span>
              {{#if item.isAttack}}Atk +{{item.innateAttack}}{{else if item.isSave}}{{item.system.defence}} DC {{item.innateSave}}{{else}}&mdash;{{/if}}
            </span>
            <div class="item-controls">
              {{#if item.usesTracked}}
                <button type="button" data-action="restoreItemUse" data-tooltip="{{#if item.isFocus}}Restore one use (Focus — a successful Refocus does this too){{else}}Restore one use{{/if}}"{{#if item.usesFull}} disabled{{/if}}>
                  <i class="fa-solid fa-rotate-left{{#if item.usesFull}} muted-icon{{/if}}"></i>
                </button>
              {{/if}}
              <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen-to-square"></i></button>
              {{#if ../editable}}
                <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </article>
      {{/if}}

      <article class="ornate-card">
        <h2>Magic Notes</h2>
        <textarea
          class="large-textarea"
          name="system.magic.notes"
          placeholder="Prepared spells, rituals, tradition notes, and magical obligations…"
        >{{system.magic.notes}}</textarea>
      </article>
    </section>

    <section
      class="tab sheet-tab-panel {{tabs.effects.cssClass}}"
      data-group="primary"
      data-tab="effects"
    >
      <div class="section-heading">
        <div>
          <span class="eyebrow">Blessings, curses, wounds, and conditions</span>
          <h2>Effects</h2>
        </div>
        <div class="heading-actions">
          <button type="button" class="gold-button" data-action="rollFatigueRecovery">
            <i class="fa-solid fa-bed"></i> Fatigue Recovery
          </button>
          <button type="button" class="gold-button" data-action="rollFrightenedRecovery">
            <i class="fa-solid fa-face-scream"></i> Frightened Recovery
          </button>
          <button type="button" class="gold-button" data-action="rollSickenedRetch">
            <i class="fa-solid fa-face-dizzy"></i> Retch (Sickened)
          </button>
          {{#if editable}}
            <button type="button" class="gold-button" data-action="effectCreate">
              <i class="fa-solid fa-plus"></i> Add Effect
            </button>
          {{/if}}
        </div>
      </div>

      {{!-- THE EFFECTS TAB (3.383.0). One table became three groups.

            It used to list `actor.effects` alone, which showed three rows
            for a character with seventeen effects acting on them: the
            permanent ones live on their parent items and arrive by
            transfer. Graham asked for the permanent ones to be moved out
            of this table and hidden; they were never in it. The grouping
            rule and the measurement behind it are in
            module/effect-grouping.mjs. --}}

      {{#if effectGroups.conditions.mechanical.length}}
        <article class="ornate-card effects-list">
          <div class="card-heading"><h2>Conditions</h2></div>
          <div class="item-list-header effect-header">
            <span>Effect</span><span>Value</span><span>Source</span>
            <span>Duration</span><span>Status</span><span></span>
          </div>
          {{#each effectGroups.conditions.mechanical as |effect|}}
            {{> "systems/trg-prime/templates/actor/effect-row.hbs" effect=this}}
          {{/each}}
        </article>
      {{/if}}

      <article class="ornate-card effects-list">
        <div class="card-heading">
          <h2>Temporary</h2>
          <span class="eyebrow">Spells, items and anything with an end</span>
        </div>
        <div class="item-list-header effect-header">
          <span>Effect</span><span>Value</span><span>Source</span>
          <span>Duration</span><span>Status</span><span></span>
        </div>
        {{#each effectGroups.temporary.mechanical as |effect|}}
          {{> "systems/trg-prime/templates/actor/effect-row.hbs" effect=this}}
        {{else}}
          <div class="empty-state">
            <i class="fa-solid fa-sun"></i>
            <p>Nothing temporary is shaping this actor.</p>
          </div>
        {{/each}}
        {{#each effectGroups.temporary.notes as |effect|}}
          {{> "systems/trg-prime/templates/actor/effect-row.hbs" effect=this}}
        {{/each}}
      </article>

      {{!-- COLLAPSED BY DEFAULT — Graham's instinct, and right: this is
            the largest group and the least often acted on. The toggle
            copies `toggleAttributeDetails` rather than inventing a second
            idiom; see its comment for why it is a DOM toggle and not a
            re-render. --}}
      <article class="ornate-card item-section permanent-effects {{#if permanentEffectsExpanded}}expanded{{/if}}">
        <div class="card-heading">
          <h2>
            Permanent
            <span class="eyebrow">From your race, heritage, background, class, abilities and feats — {{permanentEffectCount}} in all</span>
          </h2>
          <button
            type="button"
            class="heading-icon-button"
            data-action="togglePermanentEffects"
            data-tooltip="{{#if permanentEffectsExpanded}}Hide the permanent effects{{else}}Show the permanent effects{{/if}}"
            aria-expanded="{{permanentEffectsExpanded}}"
            aria-label="Permanent effects"
          ><i class="fa-solid fa-chevron-down"></i></button>
        </div>
        <div class="permanent-effects-body">
          <div class="item-list-header effect-header">
            <span>Effect</span><span>Value</span><span>Source</span>
            <span>Duration</span><span>Status</span><span></span>
          </div>
          {{#each effectGroups.permanent.mechanical as |effect|}}
            {{> "systems/trg-prime/templates/actor/effect-row.hbs" effect=this}}
          {{else}}
            <div class="empty-state">
              <i class="fa-solid fa-shield"></i>
              <p>Nothing permanent is shaping this actor.</p>
            </div>
          {{/each}}

          {{!-- NOTES ARE SEPARATED, not mixed in. Most permanent effects
                on a levelled character change nothing at all — they are
                printed reminders attached to a feat. Listing them beside
                real modifiers would replace one unusable table with
                another. --}}
          {{#if effectGroups.permanent.notes.length}}
            <div class="section-subheading">
              <span class="eyebrow">Notes — these explain a rule rather than change a number</span>
            </div>
            {{#each effectGroups.permanent.notes as |effect|}}
              {{> "systems/trg-prime/templates/actor/effect-row.hbs" effect=this}}
            {{/each}}
          {{/if}}
        </div>
      </article>

      <article class="ornate-card item-section">
        <div class="card-heading">
          <h2>Afflictions</h2>
          {{#if editable}}
            <button type="button" class="gold-button" data-action="itemCreate" data-item-type="affliction">
              <i class="fa-solid fa-plus"></i> Affliction
            </button>
          {{/if}}
        </div>
        <div class="item-list-header affliction-header">
          <span>Name</span>
          <span>Level</span>
          <span>Save</span>
          <span>Status</span>
          <span></span>
        </div>
        {{#each itemGroups.afflictions as |item|}}
          <div class="item-row affliction-row" data-item-id="{{item.id}}">
            <button type="button" class="item-name" data-action="itemEdit">
              <img src="{{item.img}}" alt="">
              <span>
                <strong>{{item.name}}</strong>
                <small>{{item.system.afflictionType}}</small>
              </span>
            </button>
            <span>{{item.system.level}}</span>
            <span>{{item.system.savingThrow}}</span>
            <span class="affliction-status">
              {{#if item.system.incubating}}
                <span class="status-pill status-incubating">Ready to Apply</span>
              {{else if item.system.currentStage}}
                <span class="status-pill status-active">Stage {{item.system.currentStage}}</span>
              {{else}}
                <span class="status-pill status-inert">Resisted</span>
              {{/if}}
            </span>
            <div class="item-controls">
              {{#if item.system.incubating}}
                <button type="button" data-action="applyAffliction" data-tooltip="Apply to targeted token(s) and roll initial exposure"><i class="fa-solid fa-syringe"></i></button>
              {{else if item.system.currentStage}}
                <button type="button" data-action="rollAfflictionStageSave" data-tooltip="Roll the stage saving throw"><i class="fa-solid fa-dice-d20"></i></button>
              {{/if}}
              <button type="button" data-action="itemEdit" data-tooltip="Edit">
                <i class="fa-solid fa-pen-to-square"></i>
              </button>
              {{#if ../editable}}
                <button type="button" data-action="itemDelete" data-tooltip="Delete">
                  <i class="fa-solid fa-trash"></i>
                </button>
              {{/if}}
            </div>
          </div>
        {{else}}
          <div class="empty-state">
            <i class="fa-solid fa-skull-crossbones"></i>
            <p>No afflictions have been added.</p>
          </div>
        {{/each}}
      </article>
    </section>

    <section
      class="tab sheet-tab-panel {{tabs.description.cssClass}}"
      data-group="primary"
      data-tab="description"
    >
      <div class="section-heading">
        <div>
          <span class="eyebrow">The story behind the statistics</span>
          <h2>Description</h2>
        </div>
      </div>

      <div class="description-layout">
        <article class="ornate-card">
          <h2>Creature Traits</h2>
          <input
            type="text"
            name="system.details.traits"
            value="{{system.details.traits}}"
            placeholder="Mindless, Construct, Evil, Undead…"
            data-tooltip="Appendix 3 traits this creature itself carries. Mindless applies -25 racial to Intelligence and Charisma and grants immunity to mental effects and damage; Construct grants immunity to Essence; an alignment trait (Good, Evil, Chaos, Order) determines which aligned damage can harm it."
          >

          {{!-- GRANTED TRAITS (3.314.0). Shown BESIDE the input, never in it.
                A Form spell's traits are derived from the active effect that
                granted them, so they are read-only here on purpose: typing
                them into the box above would survive the form expiring, and
                the box is the one field a GM owns outright. Rendered only when
                something is granting, so an ordinary character sees the card
                exactly as before. --}}
          {{#if system.details.grantedTraits}}
            <p class="hint" data-tooltip="Granted by an active effect — a Form spell or similar — and removed when it ends. Read by the same rules as the traits above.">
              <em>Also, for the duration:</em> <strong>{{system.details.grantedTraits}}</strong>
            </p>
          {{/if}}

          {{!-- CAMPAIGN ORIGIN (3.250.0). Inside the Creature Traits card
                rather than beside it, because that card held one input
                and a quarter of the tab — which is what Graham reported.
                A character has exactly one origin: picking a second
                replaces the first. --}}
          <h2 class="origin-heading">Origin</h2>
          {{#each itemGroups.origins as |item|}}
            <div class="item-row origin-row" data-item-id="{{item.id}}">
              <button type="button" class="item-name" data-action="itemEdit">
                <img src="{{item.img}}" alt="">
                <strong>{{item.name}}</strong>
              </button>
              <span>{{item.system.specialistSkill}}</span>
              <div class="item-controls">
                <button type="button" data-action="applyAllGrants" data-tooltip="Apply Grants (bonus feats, spells, specialist skills, languages)">
                  <i class="fa-solid fa-gift"></i>
                </button>
                <button type="button" data-action="itemEdit" data-tooltip="Edit"><i class="fa-solid fa-pen-to-square"></i></button>
                {{#if ../editable}}
                  <button type="button" data-action="itemDelete" data-tooltip="Remove"><i class="fa-solid fa-trash"></i></button>
                {{/if}}
              </div>
            </div>
          {{else}}
            <div class="empty-state compact">
              <p>No origin chosen.</p>
            </div>
          {{/each}}
          {{#if editable}}
            <div class="button-group compact">
              <button type="button" data-action="addFromPicker" data-slot="origin" data-tooltip="Choose a campaign origin. A character has exactly one — adding a second warns rather than replacing, the same as a race, heritage or background.">
                <i class="fa-solid fa-magnifying-glass"></i> Origin
              </button>
            </div>
          {{/if}}
        </article>
        <article class="ornate-card">
          <h2>Biography</h2>
          <textarea
            class="chronicle"
            name="system.details.biography"
            placeholder="Record the character's history…"
          >{{system.details.biography}}</textarea>
        </article>
        <article class="ornate-card">
          <h2>Appearance</h2>
          <textarea
            name="system.details.appearance"
            placeholder="Build, dress, manner, and distinguishing features…"
          >{{system.details.appearance}}</textarea>
        </article>
        <article class="ornate-card">
          <h2>Personality</h2>
          <textarea
            name="system.details.personality"
            placeholder="Temperament, habits, and voice…"
          >{{system.details.personality}}</textarea>
        </article>
        <article class="ornate-card">
          <h2>Ideals</h2>
          <textarea name="system.details.ideals">{{system.details.ideals}}</textarea>
        </article>
        <article class="ornate-card">
          <h2>Bonds</h2>
          <textarea name="system.details.bonds">{{system.details.bonds}}</textarea>
        </article>
        <article class="ornate-card">
          <h2>Flaws</h2>
          <textarea name="system.details.flaws">{{system.details.flaws}}</textarea>
        </article>
      </div>
    </section>

    {{#if isGM}}
      <section
        class="tab sheet-tab-panel {{tabs.gm.cssClass}}"
        data-group="primary"
        data-tab="gm"
      >
        <div class="section-heading gm-heading">
          <div>
            <span class="eyebrow">Behind the screen</span>
            <h2>GM</h2>
          </div>
          <i class="fa-solid fa-lock"></i>
        </div>

        <div class="gm-layout">
          <article class="ornate-card">
            <h2>Encounter Data</h2>
            <div class="field-grid three-column">
              <label data-tooltip="Effective Level (Chapter 12): what this creature is worth against the party's APL. Leave at 0 to use its level ({{system.identity.level}}).">
                <span>Effective Level</span>
                <input type="number" min="0" name="system.gm.challenge" value="{{system.gm.challenge}}" placeholder="{{system.identity.level}}">
              </label>
              <label>
                <span>DP</span>
                <input type="number" name="system.gm.dp" value="{{system.gm.dp}}">
              </label>
              <label>
                <span>Role</span>
                <input type="text" name="system.gm.role" value="{{system.gm.role}}">
              </label>
              <label>
                <span>Faction</span>
                <input type="text" name="system.gm.faction" value="{{system.gm.faction}}">
              </label>
              <label>
                <span>Disposition</span>
                <select name="system.gm.disposition">
                  {{selectOptions dispositionChoices selected=system.gm.disposition}}
                </select>
              </label>
            </div>
            <label class="wide-field checkbox-field">
              <span>Show effect internals</span>
              <input
                type="checkbox"
                name="flags.trg-prime.showEffectInternals"
                {{#if showEffectInternals}}checked{{/if}}
                data-tooltip="Reveals the attribute keys, change modes and priorities on this character's effect sheets. Hidden by default — the rules are what matters at the table."
              >
            </label>
          </article>
          {{#if isNPC}}
            <article class="ornate-card trg-peril-card">
              <h2>Peril</h2>
              <p class="hint">Chapter 12: a trap, an environmental hazard or an echo, built as an NPC. Its DB, saves, HP and defences are this sheet's own, and its Hardness is its natural-armour DR (damage to objects is reduced by their DR, Chapter 6); the rest of the stat block is here. Its XP is a creature's of its Effective Level.</p>
              <label class="checkbox-field">
                <span>This NPC is a peril</span>
                <input type="checkbox" name="system.gm.peril.enabled" {{checked system.gm.peril.enabled}}>
              </label>
              {{#if perilShown}}
                <div class="field-grid three-column">
                  <label><span>Detection skill</span>
                    <select name="system.gm.peril.detectionSkill" {{#if perilDetectionByLine}}disabled data-tooltip="The Detection line below is used instead."{{/if}}>{{selectOptions perilSkillChoices selected=system.gm.peril.detectionSkill}}</select></label>
                  <label><span>Detection (Stealth) DC</span><input type="number" min="0" name="system.gm.peril.detectionDC" value="{{system.gm.peril.detectionDC}}" {{#if perilDetectionByLine}}disabled{{/if}}></label>
                  <label data-tooltip="0: every PC gets a secret check. Above 0: only a PC Searching with this many ranks."><span>Minimum ranks</span><input type="number" min="0" name="system.gm.peril.minRank" value="{{system.gm.peril.minRank}}" {{#if perilDetectionByLine}}disabled{{/if}}></label>
                  <label data-tooltip="Thievery, Nature, Survival, Occultism or Religion — several separated by commas. Dispel always counteracts."><span>Disable with</span><input type="text" name="system.gm.peril.disableSkills" value="{{system.gm.peril.disableSkills}}" {{#if perilDisableByLine}}disabled{{/if}}></label>
                  <label><span>Disable DC</span><input type="number" min="0" name="system.gm.peril.disableDC" value="{{system.gm.peril.disableDC}}" {{#if perilDisableByLine}}disabled{{/if}}></label>
                  <label><span>Successes needed</span><input type="number" min="1" name="system.gm.peril.successes" value="{{system.gm.peril.successes}}"></label>
                  <label><span>Action type</span>
                    <select name="system.gm.peril.actionType">{{selectOptions perilActionChoices selected=system.gm.peril.actionType}}</select></label>
                  <label><span>Progress</span><input type="number" min="0" name="system.gm.peril.progress" value="{{system.gm.peril.progress}}"></label>
                  <label><span>State</span>
                    <select name="system.gm.peril.state">{{selectOptions perilStateChoices selected=system.gm.peril.state}}</select></label>
                </div>
                <h3>Haunts and echoes</h3>
                <p class="hint">Pillars of Faith, Chapter 8 — any peril may use these. Type the stat block's own lines: each skill with its DC ("Perception DC 17; Occultism or Religion DC 17, Rank 1"). A line here replaces the skill and DC above.</p>
                <label class="wide-field" data-tooltip="Several skills, each with its DC; a ', Rank n' after a DC is that group's minimum rank. Each PC rolls the one that serves them best."><span>Detection line</span><input type="text" name="system.gm.peril.detection" value="{{system.gm.peril.detection}}"></label>
                <label class="wide-field" data-tooltip="Any skill, a specialist Lore by name ('Spirit Lore'). Disable a Peril is refused for a skill the line does not name."><span>Disable line</span><input type="text" name="system.gm.peril.disable" value="{{system.gm.peril.disable}}"></label>
                {{#if perilEntriesText}}<p class="hint">{{perilEntriesText}}</p>{{/if}}
                <div class="field-grid three-column">
                  <label><span>A finished Disable</span>
                    <select name="system.gm.peril.onDisable">{{selectOptions perilOnDisableChoices selected=system.gm.peril.onDisable}}</select></label>
                  <label data-tooltip="'24 hours', '1 hour', '10 minutes'. Blank: until its next Reset (the GM's button)."><span>Suppressed for</span><input type="text" name="system.gm.peril.suppressFor" value="{{system.gm.peril.suppressFor}}"></label>
                  <label data-tooltip="0: its level. A suppressing peril (a haunt) is Counteracted at this level."><span>Counteract level</span><input type="number" min="0" name="system.gm.peril.counteractLevel" value="{{system.gm.peril.counteractLevel}}"></label>
                  <label data-tooltip="0: its Level DC (level + 14)."><span>Counteract DC</span><input type="number" min="0" name="system.gm.peril.counteractDC" value="{{system.gm.peril.counteractDC}}"></label>
                  <label class="checkbox-field" data-tooltip="Spirit Sense reveals its presence and general direction at detection, without a roll."><span>Spiritual presence</span><input type="checkbox" name="system.gm.peril.spiritPresence" {{checked system.gm.peril.spiritPresence}}></label>
                  <label class="checkbox-field" data-tooltip="A haunt 'normally has no physical body': Strikes are refused and damage passes through it."><span>No physical body</span><input type="checkbox" name="system.gm.peril.noBody" {{checked system.gm.peril.noBody}}></label>
                  <label data-tooltip="A module's registered automation for an Effect that is more than a save. Leave blank."><span>Automation</span><input type="text" name="system.gm.peril.automation" value="{{system.gm.peril.automation}}"></label>
                </div>
                {{#if perilSuppressedText}}<p class="hint"><strong>{{perilSuppressedText}}</strong></p>{{/if}}
                <label class="wide-field" data-tooltip="'+2 circumstance: speaking a remembered name' — several separated by ';'. Offered, unticked, in the disabling check's dialog."><span>Disable bonuses</span><input type="text" name="system.gm.peril.disableBonuses" value="{{system.gm.peril.disableBonuses}}"></label>
                <label class="wide-field"><span>Trigger</span><input type="text" name="system.gm.peril.trigger" value="{{system.gm.peril.trigger}}"></label>
                <label class="wide-field" data-tooltip="The Effect as printed, its ladder one degree a line ('Partial Frightened 2.'). Trigger rolls the save — the printed DC, else its Level DC — for everyone within a printed radius of its token, or for your targets, and applies the conditions and damage."><span>Effect</span><textarea name="system.gm.peril.effectText">{{system.gm.peril.effectText}}</textarea></label>
                {{#if perilEffectPreview}}<p class="hint">Trigger will apply: {{perilEffectPreview}}</p>{{/if}}
                <label class="wide-field"><span>Routine</span><textarea name="system.gm.peril.routine">{{system.gm.peril.routine}}</textarea></label>
                <label class="wide-field"><span>Anchor</span><input type="text" name="system.gm.peril.anchor" value="{{system.gm.peril.anchor}}"></label>
                <label class="wide-field"><span>Resolution</span><textarea name="system.gm.peril.resolution">{{system.gm.peril.resolution}}</textarea></label>
                <label class="wide-field"><span>Reset</span><input type="text" name="system.gm.peril.reset" value="{{system.gm.peril.reset}}"></label>
                <div class="party-reward-buttons">
                  <button type="button" data-action="perilDetect"><i class="fa-solid fa-eye"></i> Roll Detection</button>
                  <button type="button" data-action="perilTrigger"><i class="fa-solid fa-bolt"></i> Trigger</button>
                  <button type="button" data-action="perilReset"><i class="fa-solid fa-rotate-left"></i> Reset</button>
                  <button type="button" data-action="perilResolve"><i class="fa-solid fa-dove"></i> Resolve</button>
                </div>
              {{/if}}
            </article>
            <article class="ornate-card">
              <h2>Wade Through the Mooks</h2>
              <p class="hint">Chapter 7's optional rule for Minor Creatures (MNPCs, usually 4+ levels below the party). Simplifies critical hits to a flat HP-multiplier table and applies a Wound Threshold penalty to attack/defence based on remaining HP.</p>
              <label class="checkbox-field">
                <span>Treat as a Minor Creature (Mook)</span>
                <input type="checkbox" name="system.gm.isMook" {{checked system.gm.isMook}}>
              </label>
            </article>
          {{/if}}
          <article class="ornate-card">
            <h2>Treasure & Rewards</h2>
            <textarea
              name="system.gm.treasure"
              placeholder="Treasure, clues, rewards, and recoverable equipment…"
            >{{system.gm.treasure}}</textarea>
          </article>
          <article class="ornate-card gm-notes-card">
            <h2>Secret Notes</h2>
            <textarea
              class="chronicle"
              name="system.gm.notes"
              placeholder="Secrets known only to the GM…"
            >{{system.gm.notes}}</textarea>
          </article>
        </div>
      </section>
    {{/if}}
  </main>

  <footer class="sheet-footer">
    <span><i class="fa-solid fa-dragon"></i> TRG Prime</span>
    <span>Actor: {{actor.type}}</span>
    <span>System v{{systemVersion}}</span>
  </footer>
</div>
