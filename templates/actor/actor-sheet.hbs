            {{else}}
            Starting wealth score {{startingWealth.score}}
            {{#if startingWealth.pending}}
              &mdash; background wealth not yet rolled
            {{else if startingWealth.indebted}}
              &mdash; you begin in debt (Chapter 6): settle the details with your GM
            {{else}}
              &mdash; {{startingWealth.gp}} gp
            {{/if}}
            {{/if}}
          </span>
          {{#if editable}}
