<div class="trg-prime-sheet actor-sheet">
  <header class="sheet-header">
    <div class="portrait-frame">
      <img class="profile-img" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-tooltip="Click to change portrait">
      <input
        class="portrait-path"
        type="text"
        name="img"
        value="{{actor.img}}"
        aria-label="Portrait path"
      >
    </div>

    <div class="identity">
      <div class="title-row">
        <div class="name-field">
          <span class="eyebrow">{{#if isNPC}}NPC{{else if isCompanion}}Animal Companion{{else if isFamiliar}}Familiar{{else}}Adventurer{{/if}}</span>
          <input
            class="actor-name"
            type="text"
            name="name"
            value="{{actor.name}}"
            placeholder="Character Name"
          >
        </div>
        <div class="level-seal">
          <label>Level</label>
          {{#if isNPC}}
            <input
              type="number"
              name="system.identity.level"
              value="{{system.identity.level}}"
              min="0"
            >
            {{#if isGM}}
              {{!-- ADJUSTING LEVEL (3.633.0; F&F 3.0 bestiary page 5): EL ±N,
                    +N to every d20 roll and DB, ±8 HP a step. GM only. --}}
              <input
                type="number"
                class="el-adjust"
                name="flags.trg-prime.elAdjust"
                value="{{elAdjust}}"
                min="-5" max="5" step="1"
                data-tooltip="EL adjustment (GM): +1 to every d20 roll and DB, and 8 HP, per step — Fiends &amp; Fables, Adjusting Level."
              >
            {{/if}}
          {{else if isFamiliar}}
            {{!-- Its master's level, pushed across. Editable for the
                  same reason a companion's is: a GM building one by hand
                  or repairing a drifted one needs to be able to. --}}
            <input
              type="number"
              name="system.identity.level"
              value="{{system.identity.level}}"
              min="1"
              data-tooltip="Equal to your master's level. Pushed across whenever theirs changes, and again on their Daily Preparation."
            >
          {{else if isCompanion}}
            {{!-- Stored, not earned: "an animal companion has a level
                  equal to your level", pushed across when the master's
                  changes. Editable, because a GM building a companion by
                  hand or fixing a drifted one needs to be able to — but
                  the drift banner below says when the number disagrees
                  with the master rather than silently correcting it. --}}
            <input
              type="number"
              name="system.identity.level"
              value="{{system.identity.level}}"
              min="1"
              data-tooltip="Equal to your master's level. Pushed across when they level up, and again on their Daily Preparation."
            >
          {{else}}
            <output data-tooltip="Derived from XP — 10,000 per level. Edit XP in the Character tab to change it.">{{system.identity.level}}</output>
          {{/if}}
        </div>
        <button type="button" class="daily-prep-button" data-action="dailyPreparation" data-tooltip="Daily Preparation: reset uses-per-day feats and abilities">
          <i class="fa-solid fa-sun"></i>
        </button>
      </div>

      <div class="identity-grid">
        <label>
          <span>{{#if isCompanion}}Species{{else}}Race{{/if}}</span>
          <div class="identity-field">
            <input type="text" value="{{identitySummary.race.name}}" readonly data-tooltip="Derived from the {{#if isCompanion}}base creature{{else}}Race item{{/if}} in Foundations below — add or change it there.">
            {{#if identitySummary.race}}
              <button type="button" data-action="itemDelete" data-item-id="{{identitySummary.race.id}}" data-tooltip="Remove {{identitySummary.race.name}}"><i class="fa-solid fa-xmark"></i></button>
            {{/if}}
          </div>
        </label>
        {{#if isFamiliar}}
          <label>
            <span>Master</span>
            <div class="identity-field">
              <input type="text" value="{{familiarSummary.masterName}}" readonly data-tooltip="The character you are bound to. Your saves, hit points, attack and defence bonuses and every skill rank are theirs.">
              {{#if familiarSummary.masterId}}
                <button type="button" data-action="openMaster" data-tooltip="Open {{familiarSummary.masterName}}'s sheet"><i class="fa-solid fa-up-right-from-square"></i></button>
              {{/if}}
            </div>
          </label>
        {{else if isCompanion}}
          {{!-- A companion has no heritage and no background. What it
                does have, and what nothing on this sheet said until
                3.233.3, is a master. --}}
          <label>
            <span>Master</span>
            <div class="identity-field">
              <input type="text" value="{{companionSummary.masterName}}" readonly data-tooltip="The character you are bound to. Your level follows theirs.">
              {{#if companionSummary.masterId}}
                <button type="button" data-action="openMaster" data-tooltip="Open {{companionSummary.masterName}}'s sheet"><i class="fa-solid fa-up-right-from-square"></i></button>
              {{/if}}
            </div>
          </label>
        {{else}}
          <label>
            <span>Heritage</span>
            <div class="identity-field">
              <input type="text" value="{{identitySummary.heritage.name}}" readonly data-tooltip="Derived from the Heritage item in Foundations below — add or change it there.">
              {{#if identitySummary.heritage}}
                <button type="button" data-action="itemDelete" data-item-id="{{identitySummary.heritage.id}}" data-tooltip="Remove {{identitySummary.heritage.name}}"><i class="fa-solid fa-xmark"></i></button>
              {{/if}}
            </div>
          </label>
        {{/if}}
        <label>
          <span>Class</span>
          <div class="identity-field">
            <input type="text" value="{{identitySummary.class.name}}" readonly data-tooltip="Derived from the Class item in Foundations below — add or change it there.">
            {{#if identitySummary.class}}
              <button type="button" data-action="itemDelete" data-item-id="{{identitySummary.class.id}}" data-tooltip="Remove {{identitySummary.class.name}}"><i class="fa-solid fa-xmark"></i></button>
            {{/if}}
          </div>
        </label>
        {{#if isFamiliar}}
          <label>
            <span>Form</span>
            <div class="identity-field">
              <input type="text" name="system.familiar.form" value="{{familiarSummary.form}}" data-tooltip="Appearance only — an owl familiar gains no flight and a cat no claws. What it can do comes from its abilities.">
            </div>
          </label>
        {{else if isCompanion}}
          <label>
            <span>Maximum Size</span>
            <div class="identity-field">
              <input type="text" value="{{companionSummary.maximumSize}}" readonly data-tooltip="The largest this species can grow to. Increase Size steps you towards it and stops there.">
            </div>
          </label>
        {{else}}
          <label>
            <span>Background</span>
            <div class="identity-field">
              <input type="text" value="{{identitySummary.background.name}}" readonly data-tooltip="Derived from the Background item in Foundations below — add or change it there.">
              {{#if identitySummary.background}}
                <button type="button" data-action="itemDelete" data-item-id="{{identitySummary.background.id}}" data-tooltip="Remove {{identitySummary.background.name}}"><i class="fa-solid fa-xmark"></i></button>
              {{/if}}
            </div>
          </label>
        {{/if}}
      </div>

      {{#if classMinimumWarning}}
        <div class="fatigue-warning">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <strong>Below your class's minimum ability score</strong> — {{classMinimumWarning}}
        </div>
      {{/if}}

      {{#if aspectMissingWarning}}
        <div class="fatigue-warning aspect-missing-warning">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <strong>No Divine Aspect</strong> — {{aspectMissingWarning}}
        </div>
      {{/if}}

      {{#if ethicsOffList}}
        <div class="fatigue-warning ethics-off-list-warning">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <strong>{{ethicsOffList}} is not one of your aspect's ethics</strong> — a divinity caster selects one of its suggested ethics (Appendix 4).
        </div>
      {{/if}}

      {{#if isFamiliar}}
        {{#unless familiarSummary.inSync}}
          <div class="fatigue-warning">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <strong>Out of step with {{familiarSummary.masterName}}</strong> —
            {{familiarSummary.driftedLabel}} {{#if familiarSummary.drifted.length}}have{{/if}} changed on their sheet and not yet here.
            Press Daily Preparation on their sheet to catch up.
          </div>
        {{/unless}}
        {{#if familiarSummary.masterMissing}}
          <div class="fatigue-warning">
            <i class="fa-solid fa-link-slash"></i>
            <strong>Master missing</strong> — the actor this familiar was bound to
            {{#if familiarSummary.masterName}}({{familiarSummary.masterName}}){{/if}}
            is no longer in this world, so nothing will keep its numbers current.
          </div>
        {{/if}}
      {{/if}}

      {{#if isCompanion}}
        {{#unless companionSummary.inSync}}
          <div class="fatigue-warning">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <strong>Out of step with your master</strong> —
            {{companionSummary.masterName}} is level {{companionSummary.masterLevel}}, you are level {{companionSummary.companionLevel}}.
            Every number below is being derived from {{companionSummary.companionLevel}}.
            Press Daily Preparation on their sheet to catch up.
          </div>
        {{/unless}}
        {{#if companionSummary.masterMissing}}
          <div class="fatigue-warning">
            <i class="fa-solid fa-link-slash"></i>
            <strong>Master missing</strong> — the actor this companion was bound to
            {{#if companionSummary.masterName}}({{companionSummary.masterName}}){{/if}}
            is no longer in this world, so nothing will push your level any more.
          </div>
        {{/if}}
      {{/if}}

      {{#if system.identity.fatigueStatus}}
        <div class="fatigue-warning">
          {{#if isFatigueDead}}
            <i class="fa-solid fa-skull"></i> <strong>Fatigue 20+</strong> — the character dies.
          {{else}}
            <i class="fa-solid fa-face-dizzy"></i> <strong>Fatigue 10+</strong> — Unconscious until Fatigue falls below 10.
          {{/if}}
        </div>
      {{/if}}

      <div class="resource-ribbon">
        <div class="resource hp" style="--resource-pct: {{system.resources.hp.pct}}%;">
          <button type="button" class="resource-icon conviction-spend" data-action="applyDamage" data-tooltip="Apply Damage (Chapter 7, Death & Dying)"><i class="fa-solid fa-heart"></i></button>
          <label data-tooltip="Hit Points">HP</label>
          <div class="resource-values">
            <input
              type="number"
              name="system.resources.hp.value"
              value="{{system.resources.hp.value}}"
              aria-label="Current hit points"
            >
            <span>/</span>
            <input
              type="number"
              name="system.resources.hp.max"
              value="{{system.resources.hp.max}}"
              readonly
              data-tooltip="Derived: Size + (Constitution x level) + (HP per Level x level) + Other. Set HP per Level and Other on the Attributes tab."
              aria-label="Maximum hit points"
            >
            {{!-- TEMPORARY HP (3.416.0). It was rendered on the PARTY
                  sheet and nowhere else, so a raging character was
                  granted class bonus x 20 temporary HP they could only
                  see by opening somebody else's sheet. Found live,
                  26 August 2026. Shown only when there is some: a
                  permanent "+0" beside every character's HP is noise on
                  the one line people read most. --}}
            {{#if system.resources.hp.temp}}
              <span class="hp-temp-sep">+</span>
              <input
                type="number"
                class="hp-temp"
                name="system.resources.hp.temp"
                value="{{system.resources.hp.temp}}"
                data-tooltip="Temporary HP — spent before your own, and lost when whatever granted it ends."
                aria-label="Temporary hit points"
              >
            {{/if}}
          </div>
        </div>

        <div class="resource pp" style="--resource-pct: {{system.resources.pp.pct}}%;">
          <span class="resource-icon"><i class="fa-solid fa-sparkles"></i></span>
          <label data-tooltip="Power Points">PP</label>
          <div class="resource-values">
            <input
              type="number"
              name="system.resources.pp.value"
              value="{{system.resources.pp.value}}"
              aria-label="Current power points"
            >
            <span>/</span>
            {{! Maximum PP is derived from 3.206.0 — your own base, plus
                your class's PP column, plus your magical ability score.
                An input here would be overwritten on the next prepare, so
                it reads out like max HP does; the BASE is editable on the
                Magic tab, which is also where the grants write. }}
            <output
              class="pp-max"
              aria-label="Maximum power points"
              data-tooltip="Base {{system.resources.pp.base}}{{#if system.progression.pp}} + {{system.progression.pp}} from {{system.progression.source}} at level {{system.progression.level}} + {{system.resources.pp.abilityBonus}} from your magical ability score{{/if}}. Edit the base on the Magic tab."
            >{{system.resources.pp.max}}</output>
          </div>
        </div>

        <div class="resource ap" style="--resource-pct: {{system.resources.ap.pct}}%;">
          <span class="resource-icon"><i class="fa-solid fa-bolt"></i></span>
          <label data-tooltip="Action Points{{#if system.resources.ap.restricted}}: {{system.resources.ap.restrictedText}}{{/if}}">AP{{#if system.resources.ap.restricted}} <span class="ap-restricted" data-tooltip="{{system.resources.ap.restrictedText}}">({{system.resources.ap.restricted}}★)</span>{{/if}}</label>
          <div class="resource-values">
            <input
              type="number"
              name="system.resources.ap.value"
              value="{{system.resources.ap.value}}"
              aria-label="Current action points"
            >
            <span>/</span>
            <input
              type="number"
              name="system.resources.ap.max"
              value="{{system.resources.ap.max}}"
              aria-label="Maximum action points"
            >
          </div>
        </div>

        <div class="resource reactions" style="--resource-pct: {{system.resources.reactions.pct}}%;">
          <span class="resource-icon"><i class="fa-solid fa-shield-halved"></i></span>
          <label data-tooltip="Reactions">R</label>
          <div class="resource-values">
            <input
              type="number"
              name="system.resources.reactions.value"
              value="{{system.resources.reactions.value}}"
              aria-label="Current reactions"
            >
            <span>/</span>
            <input
              type="number"
              name="system.resources.reactions.max"
              value="{{system.resources.reactions.max}}"
              aria-label="Maximum reactions"
            >
          </div>
        </div>

        {{#if useConviction}}
        <div class="resource conviction" style="--resource-pct: {{system.resources.conviction.pct}}%;">
          <button type="button" class="resource-icon conviction-spend" data-action="convictionMenu" data-tooltip="Spend Conviction"><i class="fa-solid fa-star"></i></button>
          <label data-tooltip="Conviction Points">CP</label>
          <div class="resource-values">
            <input
              type="number"
              name="system.resources.conviction.value" min="0"
              value="{{system.resources.conviction.value}}"
              aria-label="Current conviction"
            >
            <span>/</span>
            <input
              type="number" min="0"
              {{#if isNPC}}data-tooltip="An NPC's pool is the GM's to give (Chapter 12): 0 unless this is a major NPC"{{else}}readonly data-tooltip="Derived: 1, +1 per 5 levels, plus feat bonuses"{{/if}}
              name="system.resources.conviction.max"
              value="{{system.resources.conviction.max}}"
              aria-label="Maximum conviction"
            >
          </div>
        </div>
        {{/if}}
      </div>
    </div>
  </header>

  <nav
    class="sheet-tabs"
    data-group="primary"
    role="tablist"
    aria-label="Actor sheet tabs"
  >
    {{#each tabList as |tab|}}
      <button
        type="button"
        class="sheet-tab {{tab.cssClass}}"
        data-action="selectTab"
        data-group="primary"
        data-tab="{{tab.id}}"
        data-tooltip="{{tab.label}}"
        role="tab"
        aria-selected="{{tab.active}}"
      >
        <i class="{{tab.icon}}"></i>
        <span>{{tab.label}}</span>
      </button>
    {{/each}}
  </nav>

  <main class="sheet-body">
    <section
      class="tab sheet-tab-panel {{tabs.summary.cssClass}}"
      data-group="primary"
      data-tab="summary"
    >
      <div class="summary-layout">
        <article class="ornate-card summary-defences">
          <h2><i class="fa-solid fa-shield-halved"></i> Combat Readiness</h2>
          <div class="hero-stat-grid">
            {{!-- A VEHICLE'S SHEET HIDES THE CREATURE NUMBERS (3.577.2,
                  Graham's ruling): Initiative, the attack bonuses,
                  Critical Resistance, Reflex, Will and the attributes.
                  See `isVehicleActor` in module/vehicles.mjs. --}}
            {{#unless isVehicle}}
            <button
              class="hero-stat"
              type="button"
              data-action="rollInitiative"
              data-tooltip="Roll Initiative"
            >
              <span class="hero-stat-label">Initiative</span>
              <strong>{{system.combat.initiative.total}}</strong>
              <i class="fa-solid fa-dice-d20"></i>
            </button>
            <div class="hero-stat">
              <span class="hero-stat-label">Melee Attack</span>
              <strong>{{system.combat.attack.total}}</strong>
              <i class="fa-solid fa-crosshairs"></i>
            </div>
            {{!-- The glossary names two: "a d20 roll + your attack bonus"
                  for melee, "a d20 roll + your ranged attack bonus" for
                  ranged. One number on the sheet meant a Dexterous
                  character read their melee total and then watched a bow
                  roll higher, with nothing to explain it. --}}
            <div class="hero-stat">
              <span class="hero-stat-label">Ranged Attack</span>
              <strong>{{system.combat.attack.ranged}}</strong>
              <i class="fa-solid fa-bullseye"></i>
            </div>
            {{/unless}}
            <div class="hero-stat">
              <span class="hero-stat-label">Defence Bonus</span>
              <strong>{{system.combat.defence.total}}</strong>
              <i class="fa-solid fa-shield"></i>
            </div>
            <div
              class="hero-stat"
              data-tooltip="Every source of Damage Reduction you have, against an ordinary physical hit: equipped armour (after the Chapter 6 BDB multiplier), Natural Armour, and any Bonus DR. Energy types halve it and essence, force, aligned, mental and poison ignore it entirely; Armour Rending, Penetrating and a critical to an unarmoured location all cut it further. The Combat tab breaks the sources out."
            >
              <span class="hero-stat-label">Damage Reduction</span>
              <strong>{{totalDR}}</strong>
              <i class="fa-solid fa-shield-halved"></i>
            </div>
            {{#unless isVehicle}}
            <div
              class="hero-stat"
              data-tooltip="Raises the Attack Value needed to reach each critical severity band. Sums Armour Master (+1 while armoured), Critical Resilience/Improved, the Armour Grants CR optional rule, and a creature type's fixed bonus."
            >
              <span class="hero-stat-label">Critical Resistance</span>
              <strong>{{system.combat.criticalResistance}}</strong>
              <i class="fa-solid fa-shield-heart"></i>
            </div>
            {{/unless}}
          </div>

          {{#if mounted}}
            <p class="hint trg-mounted-line">
              <i class="fa-solid fa-horse"></i> Mounted{{#if mounted.mount}} on <strong>{{mounted.mount}}</strong>{{/if}}.
              Use Mount / Dismount to get off.
              <a data-action="clearMounted" data-tooltip="Clear the Mounted state by hand — for a mount that has gone some other way">clear</a>
            </p>
          {{/if}}
          {{#if vehiclePilot}}
            <p class="hint trg-vehicle-pilot">
              <i class="fa-solid fa-ship"></i> Vehicle — pilot with {{vehiclePilot.skillText}}, <strong>DC {{vehiclePilot.dc}}</strong>.
              <button type="button" class="gold-button small-button" data-action="pilotVehicle" data-tooltip="Rolls the selected pilot's skill against this vehicle's DC (Chapter 6, Vehicles).">
                <i class="fa-solid fa-dice-d20"></i> Pilot
              </button>
            </p>
          {{/if}}
          {{#if steedOptions}}
            <label class="hint trg-military-mount" data-tooltip="Page 176: an animal steed gains fleeing and frightened 4 when a combat begins, unless it is a military mount.">
              <input type="checkbox" name="flags.trg-prime.militaryMount" {{checked steedOptions.military}}>
              <i class="fa-solid fa-horse-head"></i> Military mount (war-trained)
            </label>
          {{/if}}

          <h3>Saving Throws</h3>
          <div class="save-row">
            <button type="button" data-action="rollSave" data-save="fortitude">
              <span>Fortitude</span>
              <strong>{{system.combat.saves.fortitude.total}}</strong>
              <i class="fa-solid fa-dice-d20"></i>
            </button>
            {{#unless isVehicle}}
            <button type="button" data-action="rollSave" data-save="reflex">
              <span>Reflex</span>
              <strong>{{system.combat.saves.reflex.total}}</strong>
              <i class="fa-solid fa-dice-d20"></i>
            </button>
            <button type="button" data-action="rollSave" data-save="will">
              <span>Will</span>
              <strong>{{system.combat.saves.will.total}}</strong>
              <i class="fa-solid fa-dice-d20"></i>
            </button>
            {{/unless}}
          </div>
        </article>

        <article class="ornate-card summary-attributes {{#if attributesExpanded}}expanded{{/if}}">
          <h2>
            {{!-- A VEHICLE KEEPS THIS CARD FOR ITS HIT POINTS (3.577.2): the
                  HP formula's Other is how a GM's own vehicle reaches its
                  printed HP. The six attributes, the point pool and the
                  table are the creature numbers, and are hidden. --}}
            {{#if isVehicle}}<i class="fa-solid fa-heart"></i> Hit Points{{else}}<i class="fa-solid fa-dumbbell"></i> Attributes{{/if}}
            {{!-- Attributes used to be a tab of its own. Graham asked for
                  it folded in here instead: a quick medallion row stays
                  on screen, and the full editable breakdown (still every
                  field it always was — Base/Racial/Class/Item/Magic/
                  Status/Other, still saved the instant you change one)
                  sits behind this icon until clicked open. --}}
            <button
              type="button"
              class="heading-icon-button"
              data-action="toggleAttributeDetails"
              data-tooltip="{{#if attributesExpanded}}Hide the Attributes breakdown{{else}}Show the Attributes breakdown{{/if}}"
              aria-expanded="{{attributesExpanded}}"
              aria-label="Attributes breakdown"
            ><i class="fa-solid fa-chevron-down"></i></button>
          </h2>
          {{#unless isVehicle}}
          <div class="attribute-medallions">
            {{#each attributes as |attribute|}}
              <button
                type="button"
                class="attribute-medallion"
                data-action="rollAttribute"
                data-attribute="{{attribute.key}}"
                data-tooltip="Roll {{attribute.label}}"
              >
                <i class="{{attribute.icon}}"></i>
                <span>{{attribute.label}}</span>
                <strong>{{attribute.total}}</strong>
              </button>
            {{/each}}
          </div>

          {{/unless}}

          <div class="attribute-details">
            {{#unless isVehicle}}
            <div class="ability-point-banner">
              <span><strong>Point Pool:</strong> {{abilityPoints.pool}}</span>
              <span><strong>Spent:</strong> {{abilityPoints.spentDisplay}}</span>
              <span><strong>Remaining:</strong> {{abilityPoints.remaining}}</span>
              <span class="hint">
                Base at level {{abilityPoints.level}}: {{abilityPoints.min}} to {{abilityPoints.maxDisplay}}.
                Includes the +1 ability point gained at level 3 and every 3 levels thereafter.
              </span>
            </div>
            {{/unless}}

            <div class="hp-formula-banner">
              <span><strong>Max HP formula:</strong> Size + (Con &times; level) + (HP/Level &times; level) + Other</span>
              {{#if system.progression}}
                <label>
                  <span>HP per Level</span>
                  <output data-tooltip="From your class table — {{system.progression.source}} gives {{system.progression.hitPoints}} hit points per level. Remove the class item to go back to typing this by hand.">{{system.progression.hitPoints}}</output>
                </label>
              {{else}}
                <label>
                  <span>HP per Level</span>
                  <input type="number" name="system.resources.hp.hpPerLevel" value="{{system.resources.hp.hpPerLevel}}" data-tooltip="Your class's HP-per-level rate. A class item with a progression table supplies this automatically; type it here for an NPC or a character with no class item.">
                </label>
              {{/if}}
              <label>
                <span>Other</span>
                <input type="number" name="system.resources.hp.other" value="{{system.resources.hp.other}}" data-tooltip="A flat, non-scaling catch-all for anything else affecting Max HP (feats, magic items, etc.).">
              </label>
            </div>

            {{#unless isVehicle}}
            <div class="attribute-table ornate-table">
              <div class="table-row table-header">
                <span>Attribute</span>
                <span>Base</span>
                <span>Racial</span>
                <span>Class</span>
                <span>Item</span>
                <span>Magic</span>
                <span>Status</span>
                <span>Other</span>
                <span>Total</span>
              </div>
              {{#each attributes as |attribute|}}
                <div class="table-row">
                  <button
                    type="button"
                    class="row-title rollable"
                    data-action="rollAttribute"
                    data-attribute="{{attribute.key}}"
                  >
                    <i class="{{attribute.icon}}"></i>
                    <span>{{attribute.label}}</span>
                    <i class="fa-solid fa-dice-d20 roll-icon"></i>
                  </button>
                  <input
                    type="number"
                    name="system.attributes.{{attribute.key}}.base"
                    value="{{attribute.base}}"
                    min="{{../abilityPoints.min}}"
                    max="{{../abilityPoints.max}}"
                    aria-label="{{attribute.label}} base"
                  >
                  <input
                    type="number"
                    name="system.attributes.{{attribute.key}}.racial"
                    value="{{attribute.racial}}"
                    aria-label="{{attribute.label}} racial"
                  >
                  <input
                    type="number"
                    name="system.attributes.{{attribute.key}}.class"
                    value="{{attribute.class}}"
                    aria-label="{{attribute.label}} class"
                  >
                  <input
                    type="number"
                    name="system.attributes.{{attribute.key}}.item"
                    value="{{attribute.item}}"
                    aria-label="{{attribute.label}} item"
                  >
                  <input
                    type="number"
                    name="system.attributes.{{attribute.key}}.magic"
                    value="{{attribute.magic}}"
                    aria-label="{{attribute.label}} magic"
                  >
                  <input
                    type="number"
                    name="system.attributes.{{attribute.key}}.status"
                    value="{{attribute.status}}"
                    aria-label="{{attribute.label}} status"
                  >
                  <input
                    type="number"
                    name="system.attributes.{{attribute.key}}.other"
                    value="{{attribute.other}}"
                    aria-label="{{attribute.label}} other"
                  >
                  <output>{{attribute.total}}</output>
                </div>
              {{/each}}
            </div>
            {{/unless}}
          </div>
        </article>

        <article class="ornate-card summary-identity">
          <h2><i class="fa-solid fa-id-card"></i> {{#if isCompanion}}Companion{{else if isFamiliar}}Familiar{{else}}Character{{/if}}</h2>
          <div class="field-grid two-column">
            {{#if isFamiliar}}
              <label>
                <span>Effective Level</span>
                <output data-tooltip="Half your master's level, rounded down — what your familiar counts as for party level and anything else that asks.">{{familiarSummary.effectiveLevel}}</output>
              </label>
              <label>
                <span>Action Points</span>
                <output data-tooltip="A familiar gains 2 AP a round when commanded, or 3 with the Familiar Focus ability. Commanding it costs you a 1 AP Interact action.">{{familiarSummary.actionPoints}}</output>
              </label>
            {{else if isCompanion}}
              {{!-- Archetype, Ethics, Deity, XP and Next Level are all
                    Chapter 1 character apparatus and none of them applies
                    to an animal. XP in particular was actively
                    misleading: a companion's level is pushed from its
                    master, so the box could be edited all day and change
                    nothing. What replaces them is the one number a
                    companion has that a character does not. --}}
              <label>
                <span>Effective Level</span>
                <output data-tooltip="The Animal Companion table's own EL column — what your companion counts as for anything that cares about a creature's level rather than its own progression.">{{#if companionEffectiveLevel}}{{companionEffectiveLevel}}{{else}}—{{/if}}</output>
              </label>
              <label>
                <span>Starting Size</span>
                <output data-tooltip="The size this species begins at. Increase Size steps up from here towards the maximum.">{{#if companionSummary.startingSize}}{{companionSummary.startingSize}}{{else}}—{{/if}}</output>
              </label>
            {{else}}
              <label>
                <span>Archetype</span>
                <input
                  type="text"
                  name="system.identity.archetype"
                  value="{{system.identity.archetype}}"
                >
              </label>
              <label>
                <span>Ethics</span>
                {{!-- TRG Prime uses the Ethics Alignment System (Chapter 8)
                      instead of a traditional alignment grid — a closed
                      list of fifteen, not free text. The tooltip carries
                      the book's own Guiding Principle for whatever is
                      picked, so the choice reads as something on the
                      sheet rather than a name you have to go look up. --}}
                <select
                  name="system.identity.ethics"
                  data-tooltip="{{#if ethicsPrinciple}}{{ethicsPrinciple}}{{else}}Chapter 8 — the Ethics Alignment System. Choose the orientation closest to your character.{{/if}}"
                >
                  {{selectOptions ethicsChoices selected=system.identity.ethics}}
                </select>
              </label>
              <label>
                <span>Deity</span>
                <input
                  type="text"
                  name="system.identity.deity"
                  value="{{system.identity.deity}}"
                >
              </label>
            {{/if}}
            <label>
              <span>Size</span>
              <select name="system.identity.size">
                {{selectOptions sizeChoices selected=system.identity.size}}
              </select>
            </label>
            {{#unless isCompanion}}{{#unless isFamiliar}}
              <label>
                <span>XP</span>
                {{#if isNPC}}
                  <input
                    type="number"
                    name="system.identity.xp.value"
                    value="{{system.identity.xp.value}}"
                  >
                {{else}}
                  <input
                    type="number"
                    name="system.identity.xp.value"
                    value="{{system.identity.xp.value}}"
                    data-tooltip="10,000 XP per level. Reaching the threshold below raises Level automatically."
                  >
                {{/if}}
              </label>
              <label>
                <span>Next Level</span>
                {{#if isNPC}}
                  <input
                    type="number"
                    name="system.identity.xp.max"
                    value="{{system.identity.xp.max}}"
                  >
                {{else}}
                  <output data-tooltip="XP needed to reach your next level.">{{system.identity.xp.max}}</output>
                {{/if}}
              </label>
            {{/unless}}{{/unless}}
            <label>
              <span>Class Bonus</span>
              <output>{{system.identity.classBonus}}</output>
            </label>
            <label>
              <span>Gender</span>
              <input type="text" name="system.identity.gender" value="{{system.identity.gender}}">
            </label>
            <label>
              <span>Age</span>
              <input type="text" name="system.identity.age" value="{{system.identity.age}}">
            </label>
            <label>
              <span>Height</span>
              <input type="text" name="system.identity.height" value="{{system.identity.height}}">
            </label>
            <label>
              <span>Weight</span>
              <input type="text" name="system.identity.weight" value="{{system.identity.weight}}">
            </label>
            <div class="trg-language-panel wide-field{{#if languages.over}} is-over{{/if}}" data-tooltip="{{languages.tooltip}}">
              <div class="trg-language-header">
                <span>Languages</span>
                <span class="trg-language-count">
                  <strong>{{languages.headline}}</strong>
                  <em>{{languages.status}}</em>
                  {{#if languages.total}}<em class="trg-language-split">{{languages.split}}</em>{{/if}}
                </span>
                {{#if editable}}
                  <button type="button" class="gold-button" data-action="manageLanguages">
                    <i class="fa-solid fa-comments"></i> Manage
                  </button>
                {{/if}}
              </div>
              <div class="trg-language-chips">
                {{#each languages.core}}
                  <span class="trg-language-chip is-core" data-tooltip="Core language from {{this.source}} — always known, costs no pick.">{{this.name}}<em>{{this.source}}</em></span>
                {{/each}}
                {{#each languages.chosen}}
                  <span class="trg-language-chip{{#if this.flagged}} is-off-list{{/if}}"{{#if this.flagged}} data-tooltip="Off your race's list with no free slot left to cover it. Kept — only 1st-level picks are held to the racial list, and a GM may allow others by campaign."{{/if}}>{{this.name}}<em>{{this.rarity}}</em></span>
                {{/each}}
                {{#each languages.temporary}}
                  <span class="trg-language-chip is-temporary" data-tooltip="From {{this.source}} — until your next daily preparation. Costs no pick.">{{this.name}}<em>today</em></span>
                {{/each}}
                {{#unless languages.known}}
                  <span class="empty-state-compact">No languages yet — add a Race below, then use Manage.</span>
                {{/unless}}
              </div>
            </div>
            <label>
              <span>Loyalties</span>
              <input
                type="text"
                name="system.identity.loyalties"
                value="{{system.identity.loyalties}}"
              >
            </label>
          </div>
        </article>

        <article class="ornate-card summary-movement">
          <h2><i class="fa-solid fa-person-walking"></i> Movement & Load</h2>
          <div class="movement-grid">
            <label>
              <span>Land</span>
              <input
                type="number"
                name="system.combat.movement.land.base"
                value="{{system.combat.movement.land.base}}"
              >
              <small>ft</small>
            </label>
            <label>
              <span>Fly</span>
              <input
                type="number"
                name="system.combat.movement.fly.base"
                value="{{system.combat.movement.fly.base}}"
              >
              <small>ft</small>
            </label>
            <label>
              <span>Swim</span>
              <input
                type="number"
                name="system.combat.movement.swim.base"
                value="{{system.combat.movement.swim.base}}"
              >
              <small>ft</small>
            </label>
            <label>
              <span>Climb</span>
              <input
                type="number"
                name="system.combat.movement.climb.base"
                value="{{system.combat.movement.climb.base}}"
              >
              <small>ft</small>
            </label>
          </div>
          <div class="encumbrance-line">
            <span>Encumbrance</span>
            <strong>{{system.encumbrance.value}}</strong>
            <span>/</span>
            <input
              type="number"
              readonly data-tooltip="Weight Allowance: 50 + Strength x 10"
              name="system.encumbrance.max"
              value="{{system.encumbrance.max}}"
            >
          </div>
          {{#if system.encumbrance.stowage.shown}}
            <div class="encumbrance-line{{#if system.encumbrance.stowage.over}} investment-over{{/if}}">
              <span>Stowed</span>
              <strong data-tooltip="Carried in a Never-Ending Stash Sack, which 'always weighs the same amount regardless of the weight of the objects placed within it'. Stowed weight does not count towards Encumbrance up to the sacks' capacity; anything over it does. Only INVESTED sacks provide capacity.">{{system.encumbrance.stowage.stowed}}</strong>
              <span>/</span>
              <output data-tooltip="Total capacity of every invested Stash Sack.">{{system.encumbrance.stowage.capacity}}</output>
            </div>
            {{#if system.encumbrance.stowage.over}}
              <p class="hint duplicate-slot-warning">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <strong>{{system.encumbrance.stowage.over}} lb over capacity.</strong>
                The excess is carried — it counts towards Encumbrance.
              </p>
            {{/if}}
          {{/if}}
          <div class="encumbrance-line">
            <span>Armour Check Penalty</span>
            <strong data-tooltip="Summed from equipped armour and shields, doubled per-piece if not proficient. Applied automatically to Dexterity- and Strength-based skills.">{{#if system.combat.acp.total}}-{{system.combat.acp.total}}{{else}}0{{/if}}</strong>
          </div>
          {{#if endeavourEnabled}}
            {{!-- Movement & Load's own content leaves this card shorter than
                  its row-mate (Character, with the Languages panel) — the
                  grid stretches the card to match anyway, leaving blank
                  space at the bottom. The Endeavour table lives there
                  rather than in a card of its own below, which is why it
                  reads level with Languages rather than under this card. --}}
            <div class="endeavour-panel">
              <div class="encumbrance-line">
                <span>Endeavour</span>
                <input
                  type="number"
                  name="system.resources.endeavour.value"
                  value="{{system.resources.endeavour.value}}"
                  data-tooltip="Optional rule. Earned for extreme results and GM-judged risk or significant challenge — tracked by hand, since the GM is the judge of both."
                >
              </div>
              <div class="encumbrance-line">
                <span>Endeavour Spent</span>
                <output data-tooltip="Lifetime total spent on downtime purchases.">{{system.resources.endeavour.spent}}</output>
              </div>
              <button type="button" class="gold-button" data-action="endeavourMenu">
                <i class="fa-solid fa-coins"></i> Spend Endeavour
              </button>
            </div>
          {{/if}}
        </article>

        <article class="ornate-card summary-notes">
          <h2><i class="fa-solid fa-feather"></i> Quick Notes</h2>
          <textarea
            name="system.details.notes"
            placeholder="Oaths, reminders, wounds, and discoveries…"
          >{{system.details.notes}}</textarea>
        </article>
      </div>
    </section>

    <section
      class="tab sheet-tab-panel {{tabs.combat.cssClass}}"
      data-group="primary"
      data-tab="combat"
    >
      <div class="section-heading">
        <div>
          <span class="eyebrow">Steel, speed, and survival</span>
          {{!-- Proficiencies were shown nowhere at all, so the -4
                non-proficiency penalty turned up on attack rolls with
                nothing on the character to explain it. They were then
                shown as a row of chips under this heading, which for a
                Druid ran to thirteen of them and pushed the whole tab
                down. Reference, read once — so it is behind this icon
                now, the same treatment the Skills breakdown got. --}}
          <h2>
            Combat
            {{#if hasProficiencies}}
              <button
                type="button"
                class="heading-icon-button"
                data-action="showProficiencies"
                data-tooltip="What {{actor.name}} is proficient with"
                aria-label="Proficiencies"
              ><i class="fa-solid fa-shield-halved"></i></button>
            {{/if}}
          </h2>
        </div>
        <div class="heading-actions">
          <button type="button" class="gold-button" data-action="rollFlatCheck" data-dc="10">
            <i class="fa-solid fa-dice-d20"></i> Flat Check
          </button>
          {{#unless isVehicle}}
          <button type="button" class="gold-button" data-action="rollInitiative">
            <i class="fa-solid fa-dice-d20"></i> Roll Initiative
          </button>
          {{/unless}}
          <button type="button" class="gold-button" data-action="rollExhaustionCheck">
            <i class="fa-solid fa-person-running"></i> Exhaustion Check
          </button>
          <button type="button" class="gold-button" data-action="rollSleepingInArmour">
            <i class="fa-solid fa-shield-halved"></i> Sleeping in Armour
          </button>
          <button type="button" class="gold-button" data-action="rollFalling">
            <i class="fa-solid fa-person-falling"></i> Falling
          </button>
          <button type="button" class="gold-button" data-action="rollCounteractCheck">
            <i class="fa-solid fa-hand-sparkles"></i> Counteract
          </button>
          <button type="button" class="gold-button" data-action="rollNaturalHealing">
            <i class="fa-solid fa-hand-holding-heart"></i> Natural Healing
          </button>
        </div>
      </div>

      <div class="combat-layout">
        <article class="ornate-card">
          <h2>Attack & Defence</h2>
          <div class="combat-matrix">
            <div class="matrix-header">
              <span></span>
              <span>Base</span>
              <span>Ability</span>
              <span>Class</span>
              <span>Item</span>
              <span>Status</span>
              <span>Circ.</span>
              <span>Other</span>
              <span>Total</span>
            </div>
            {{#unless isVehicle}}
            <div class="matrix-row">
              {{!-- The editable slots are shared by both attack bonuses;
                    only the ability term differs, so the ranged total is
                    shown in the hero row rather than given a second row of
                    inputs that would pretend to be independently editable. --}}
              <strong>Melee Attack Bonus</strong>
              <output>{{system.combat.attack.base}}</output>
              <output>{{system.combat.attack.ability}}</output>
              <input type="number" name="system.combat.attack.class" value="{{system.combat.attack.class}}">
              <input type="number" name="system.combat.attack.item" value="{{system.combat.attack.item}}">
              <input type="number" name="system.combat.attack.status" value="{{system.combat.attack.status}}">
              <input
                type="number"
                name="system.combat.attack.circumstance"
                value="{{system.combat.attack.circumstance}}"
              >
              <input type="number" name="system.combat.attack.other" value="{{system.combat.attack.other}}">
              <output>{{system.combat.attack.total}}</output>
            </div>
            {{/unless}}
            <div class="matrix-row">
              <strong>Defence Bonus</strong>
              <output>{{system.combat.defence.base}}</output>
              <output>{{system.combat.defence.ability}}</output>
              <output>{{system.combat.defence.class}}</output>
              <input type="number" name="system.combat.defence.item" value="{{system.combat.defence.item}}">
              <input type="number" name="system.combat.defence.status" value="{{system.combat.defence.status}}">
              <input
                type="number"
                name="system.combat.defence.circumstance"
                value="{{system.combat.defence.circumstance}}"
              >
              <input type="number" name="system.combat.defence.other" value="{{system.combat.defence.other}}">
              <output>{{system.combat.defence.total}}</output>
            </div>
          </div>

          {{#unless isVehicle}}
          <div class="field-grid four-column compact-fields">
            <label>
              <span>Attack Ability</span>
              <select name="system.combat.attack.abilityKey">
                {{selectOptions abilityChoices selected=system.combat.attack.abilityKey}}
              </select>
            </label>
            <label>
              <span>BAB Base</span>
              <input type="number" name="system.combat.bab.base" value="{{system.combat.bab.base}}">
            </label>
            <label>
              <span>BAB Class</span>
              <input type="number" name="system.combat.bab.class" value="{{system.combat.bab.class}}">
            </label>
            <label>
              <span>BAB Other</span>
              <input type="number" name="system.combat.bab.other" value="{{system.combat.bab.other}}">
            </label>
            {{#if system.progression}}
              <label>
                <span>BAB ({{system.progression.source}})</span>
                <output data-tooltip="From your class table at level {{system.progression.level}}. It updates itself when your level changes — the three fields beside it stay yours.">{{system.progression.bab}}</output>
              </label>
            {{/if}}
            <label>
              <span>Total BAB</span>
              <output>{{system.combat.bab.total}}</output>
            </label>
            <label>
              <span>BDB Class</span>
              <input type="number" name="system.combat.bdb.class" value="{{system.combat.bdb.class}}">
            </label>
            <label>
              <span>BDB Other</span>
              <input type="number" name="system.combat.bdb.other" value="{{system.combat.bdb.other}}">
            </label>
            {{#if system.progression}}
              <label>
                <span>BDB ({{system.progression.source}})</span>
                <output data-tooltip="From your class table at level {{system.progression.level}}.">{{system.progression.bdb}}</output>
              </label>
            {{/if}}
            <label>
              <span>Total BDB</span>
              <output>{{system.combat.bdb.total}}</output>
            </label>
            <label>
              <span>MAP</span>
              <input type="number" name="system.combat.map" value="{{system.combat.map}}">
            </label>
            <label>
              <span>Reach</span>
              <div class="input-with-unit">
                <input type="number" name="system.combat.reach" value="{{system.combat.reach}}" readonly data-tooltip="Derived from Size (Chapter 1). Edit the Size field on the Identity tab to change this.">
                <small>ft</small>
              </div>
            </label>
          </div>
          {{/unless}}
        </article>

        <article class="ornate-card">
          <h2>Saving Throws</h2>
          <div class="field-grid two-column" style="margin-bottom:8px">
            <label class="field">
              <span>Death State</span>
              <input
                type="number"
                name="system.combat.deathState"
                value="{{system.combat.deathState}}"
                data-tooltip="Dying above this value means death. Usually 5; 4 for the frail, 6 for the resilient."
              >
            </label>
            <button type="button" class="gold-button" data-action="promptSetDoomed" style="align-self:end">
              <i class="fa-solid fa-skull"></i> Doomed
            </button>
            <button type="button" class="gold-button" data-action="promptSetSoulDrain" style="align-self:end">
              <i class="fa-solid fa-heart-crack"></i> Soul Drain
            </button>
            {{#if enableLuck}}
              <label class="field">
                <span>Luck</span>
                <input
                  type="number"
                  name="system.resources.luck.value"
                  value="{{system.resources.luck.value}}"
                  data-tooltip="Appendix 5, optional rule. Belongs to the player, not the character, per the rulebook — carry this manually between characters if you want that."
                >
              </label>
              <button type="button" class="gold-button" data-action="rollLuckCheck" style="align-self:end" data-tooltip="Arm luck for your next skill check, attack or saving throw — or roll a luck check now.">
                <i class="fa-solid fa-clover"></i> Luck{{#if luckArmed}} (armed){{/if}}
              </button>
            {{/if}}
          </div>
          {{#if system.progression}}
            <p class="hint">Your class contributes its base save at level {{system.progression.level}} on top of these: Fort +{{system.progression.fortitude}}, Ref +{{system.progression.reflex}}, Will +{{system.progression.will}} from {{system.progression.source}}. The columns below stay yours.</p>
          {{/if}}
          <div class="save-table">
            <div class="save-table-header">
              <span>Save</span>
              <span>Ability</span>
              <span>Class</span>
              <span>Item</span>
              <span>Status</span>
              <span>Other</span>
              <span>Total</span>
            </div>
            <div class="save-table-row">
              <button type="button" data-action="rollSave" data-save="fortitude">
                Fortitude <i class="fa-solid fa-dice-d20"></i>
              </button>
              <output>{{system.combat.saves.fortitude.ability}}</output>
              <input
                type="number"
                name="system.combat.saves.fortitude.class"
                value="{{system.combat.saves.fortitude.class}}"
              >
              <input
                type="number"
                name="system.combat.saves.fortitude.item"
                value="{{system.combat.saves.fortitude.item}}"
              >
              <input
                type="number"
                name="system.combat.saves.fortitude.status"
                value="{{system.combat.saves.fortitude.status}}"
              >
              <input
                type="number"
                name="system.combat.saves.fortitude.other"
                value="{{system.combat.saves.fortitude.other}}"
              >
              <output class="final-total">{{system.combat.saves.fortitude.total}}</output>
            </div>
            {{#unless isVehicle}}
            <div class="save-table-row">
              <button type="button" data-action="rollSave" data-save="reflex">
                Reflex <i class="fa-solid fa-dice-d20"></i>
              </button>
              <output>{{system.combat.saves.reflex.ability}}</output>
              <input
                type="number"
                name="system.combat.saves.reflex.class"
                value="{{system.combat.saves.reflex.class}}"
              >
              <input
                type="number"
                name="system.combat.saves.reflex.item"
                value="{{system.combat.saves.reflex.item}}"
              >
              <input
                type="number"
                name="system.combat.saves.reflex.status"
                value="{{system.combat.saves.reflex.status}}"
              >
              <input
                type="number"
                name="system.combat.saves.reflex.other"
                value="{{system.combat.saves.reflex.other}}"
              >
              <output class="final-total">{{system.combat.saves.reflex.total}}</output>
            </div>
            <div class="save-table-row">
              <button type="button" data-action="rollSave" data-save="will">
                Will <i class="fa-solid fa-dice-d20"></i>
              </button>
              <output>{{system.combat.saves.will.ability}}</output>
              <input
                type="number"
                name="system.combat.saves.will.class"
                value="{{system.combat.saves.will.class}}"
              >
              <input
                type="number"
                name="system.combat.saves.will.item"
                value="{{system.combat.saves.will.item}}"
              >
              <input
                type="number"
                name="system.combat.saves.will.status"
                value="{{system.combat.saves.will.status}}"
              >
              <input
                type="number"
                name="system.combat.saves.will.other"
                value="{{system.combat.saves.will.other}}"
              >
              <output class="final-total">{{system.combat.saves.will.total}}</output>
            </div>
            {{/unless}}
          </div>
        </article>

        <article class="ornate-card armour-card">
          <h2>Protection</h2>
          <div class="field-grid three-column">
            <label>
              <span>Armour DR</span>
              <output data-tooltip="The best suit of body armour, plus the fittings (bracers, greaves, helmets), including quality/material bonuses. Broken armour halves its own contribution; destroyed armour contributes nothing.">{{system.combat.armour.dr}}</output>
              {{#if system.combat.armour.suitsWarning}}<span class="hint warning"><i class="fa-solid fa-triangle-exclamation"></i> {{system.combat.armour.suitsWarning}}</span>{{/if}}
            </label>
            <label>
              <span>Armour Hardness</span>
              <output data-tooltip="From the first equipped armour piece (most characters wear one primary body armour item).">{{system.combat.armour.hardness}}</output>
            </label>
            <label>
              <span>Armour Rending</span>
              <input
                type="number"
                name="system.combat.armour.rending"
                value="{{system.combat.armour.rending}}"
              >
            </label>
            <label>
              <span>Shield DR (Base)</span>
              <output data-tooltip="Summed from equipped shields, including quality/material bonuses. Broken shields halve their own contribution; destroyed shields contribute nothing. This is the BASE value — Shield Block uses the multiplied figure beside it.">{{system.combat.shield.dr}}</output>
            </label>
            <label>
              <span>Shield Block DR</span>
              <output data-tooltip="What a Shield Block actually stops: the base beside this, multiplied by your BDB exactly the way worn armour's DR is (Chapter 6). A shield gives no passive Damage Reduction — it applies only when you spend the reaction, which is why it is absent from the Summary tab's Damage Reduction.">{{system.combat.shield.blockDR}}</output>
            </label>
            <label>
              <span>Shield Hardness</span>
              <output data-tooltip="From the first equipped shield.">{{system.combat.shield.hardness}}</output>
            </label>
            <label>
              <span>Natural Armour (Flat)</span>
              <input
                type="number"
                name="system.combat.naturalArmourFlat.natural"
                value="{{system.combat.naturalArmourFlat.natural}}"
                data-tooltip="A static DR bonus that never scales with BDB (Chapter 7). Competes with Base Natural Armour and any feat/spell-granted Natural Armour — only the higher of all sources applies, they don't add together."
              >
            </label>
            <label>
              <span>Natural Armour (Base)</span>
              <input
                type="number"
                name="system.combat.naturalArmourBase.natural"
                value="{{system.combat.naturalArmourBase.natural}}"
                data-tooltip="Scales with BDB exactly like equipped armour's own DR (Chapter 7) — enter the base value only, the multiplier is applied automatically."
              >
            </label>
            <label>
              <span>Natural Armour DR</span>
              <output data-tooltip="The higher of Flat and Base (after BDB scaling) — Natural Armour's two forms don't stack together.">{{system.combat.naturalArmour.dr}}</output>
            </label>
            {{!-- BONUS DR AND THE TOTAL. Reported by Graham (13 Aug 2026):
                  a Dwarf with the Storgar heritage read 0 in every box on
                  this card, so the +1 "looked like it wasn't applying".
                  It WAS applying — Storgar, Dracoris and Iron Hide grant
                  DR that always adds rather than competing with Natural
                  Armour, so it lands in its own pool, and this card had
                  no row for that pool at all. The Summary's Damage
                  Reduction tooltip promises "The Combat tab breaks the
                  sources out", which was untrue for the one source most
                  likely to be non-zero on a low-level character.

                  The total repeats the Summary's headline figure rather
                  than recomputing it — `totalDR` is built once in
                  _prepareContext from damage.mjs's own function, so the
                  rows above and the number below cannot drift apart. --}}
            <label>
              <span>Bonus DR</span>
              <output data-tooltip="{{system.combat.dr.tooltip}}">{{system.combat.dr.total}}</output>
            </label>
            <label>
              <span>Damage Reduction (total)</span>
              <output data-tooltip="Armour DR (after the Chapter 6 BDB multiplier) + Natural Armour DR + Bonus DR — the same figure as the Summary tab's headline, against an ordinary physical hit. Shield DR is excluded: it applies only through the Shield Block reaction.">{{totalDR}}</output>
            </label>
          </div>
        </article>

        <article class="ornate-card">
          <h2>Defences & Movement</h2>
          {{!-- Land/Fly/Swim/Climb are edited on the Summary tab's own
                Movement & Load card (both panels live in the DOM at
                once, tabs just hide the inactive one) — read-only here
                on purpose. A second `name="system.combat.movement..."`
                input duplicated here used to submit alongside the
                Summary one on every change; Foundry collected both
                same-named values into an array instead of a single
                number, silently corrupting the stored field to
                `[value, value]` (migrateMovementArrays in migration.mjs
                repairs any actor already carrying one). Burrow has no
                Summary counterpart, so it stays the one editable field
                in this card. --}}
          <div class="field-grid three-column">
            <label>
              <span>Land</span>
              <output data-tooltip="Edit on the Summary tab's Movement & Load card.">{{system.combat.movement.land.total}}</output>
            </label>
            <label>
              <span>Fly</span>
              <output data-tooltip="Edit on the Summary tab's Movement & Load card.">{{system.combat.movement.fly.total}}</output>
            </label>
            <label>
              <span>Swim</span>
              <output data-tooltip="Edit on the Summary tab's Movement & Load card.">{{system.combat.movement.swim.total}}</output>
            </label>
            <label>
              <span>Climb</span>
              <output data-tooltip="Edit on the Summary tab's Movement & Load card.">{{system.combat.movement.climb.total}}</output>
            </label>
            <label>
              <span>Burrow</span>
              <input
                type="number"
                name="system.combat.movement.burrow.base"
                value="{{system.combat.movement.burrow.base}}"
              >
            </label>
          </div>
          {{#if senseLines.length}}
            <div class="wide-field">
              <span>Senses</span>
              <ul class="trg-defence-summary">
                {{#each senseLines}}
                  <li data-tooltip="{{#if modality}}{{modality}} · {{/if}}sensed entirely by this: {{detects}}.{{#if enhanced}} Doubled from {{baseFeet}} ft by an Enhanced feat.{{/if}}{{#if nameRangeDisagrees}} This ability is NAMED as {{claimedFeet}} ft, but its range works out at {{baseFeet}} ft — the name is stale and worth correcting on the item itself.{{/if}}{{#if note}} {{note}}{{/if}}">
                    {{text}}{{#if enhanced}} <em>(doubled)</em>{{/if}}{{#if nameRangeDisagrees}} <em>(name says {{claimedFeet}} ft)</em>{{/if}}
                  </li>
                {{/each}}
              </ul>
            </div>
          {{/if}}
          {{#if visualRange}}
            <div class="wide-field">
              <span>Sight here</span>
              <ul class="trg-defence-summary">
                {{#if visualRange.blinded}}
                  <li data-tooltip="Blinding Light's printed effect is blindness, not a shorter range — so the ranges above are unchanged and this is what applies instead.">
                    <strong>{{visualRange.levelName}}</strong> — blinded
                  </li>
                {{else}}
                  {{#each visualRange.rows}}
                    <li data-tooltip="{{name}} reaches {{baseFeet}} ft in good light.{{#if blind}} At this level it sees nothing at all.{{else if reduced}} Cut to {{feet}} ft by the light here.{{else}} Unaffected by the light here.{{/if}}">
                      {{name}} {{#if blind}}<strong>cannot see</strong>{{else}}<strong>{{feet}} ft.</strong>{{#if reduced}} <em>(from {{baseFeet}})</em>{{/if}}{{/if}}
                    </li>
                  {{/each}}
                {{/if}}
                <li class="trg-muted" data-tooltip="{{#if visualRange.raised}}The area is {{visualRange.ambientName}}; this creature's own senses lift it {{visualRange.steps}} {{#if visualRange.oneStep}}step{{else}}steps{{/if}} to {{visualRange.levelName}}.{{else}}The light level where this creature's token is standing.{{/if}}">
                  <em>{{#if visualRange.raised}}{{visualRange.ambientName}}, seen as {{visualRange.levelName}} (+{{visualRange.steps}}){{else}}{{visualRange.levelName}}{{/if}}</em>
                </li>
              </ul>
            </div>
          {{/if}}
          <label class="wide-field">
            <span>Resistances</span>
            <input
              type="text"
              name="system.combat.resistances"
              value="{{defenceStored.resistances}}"
              placeholder="fire, cold, physical"
              data-tooltip="Damage types, halved. A group name covers its whole group: physical, energy, special."
            >
          </label>
          {{#if defenceGranted.resistances}}
            <p class="hint trg-defence-granted" data-tooltip="Added by effects on this creature (its creature type, abilities, items, conditions). Not typed here, so not saved here: change the effect to change these.">Also from effects: {{defenceGranted.resistances}}</p>
          {{/if}}
          <label class="wide-field">
            <span>Immunities</span>
            <input
              type="text"
              name="system.combat.immunities"
              value="{{defenceStored.immunities}}"
              placeholder="stun, mental, fire"
              data-tooltip="One list. Each entry applies wherever it is valid: a damage type stops damage and criticals of that type, a condition stops that condition, a trait stops any effect carrying it. Mental does all three."
            >
          </label>
          {{#if defenceGranted.immunities}}
            <p class="hint trg-defence-granted" data-tooltip="Added by effects on this creature (its creature type, abilities, items, conditions). Not typed here, so not saved here: change the effect to change these.">Also from effects: {{defenceGranted.immunities}}</p>
          {{/if}}
          {{#if defenceSummary.length}}
            <ul class="trg-defence-summary">
              {{#each defenceSummary}}
                <li class="{{#unless matched}}trg-defence-unresolved{{/unless}}">
                  <strong>{{entry}}</strong> — {{summary}}
                </li>
              {{/each}}
            </ul>
          {{/if}}
          <label class="wide-field">
            <span>Weaknesses</span>
            <input
              type="text"
              name="system.combat.weaknesses"
              value="{{defenceStored.weaknesses}}"
              placeholder="fire, cold"
              data-tooltip="Damage types, increased by 50%. Group names work here too."
            >
          </label>
          {{#if defenceGranted.weaknesses}}
            <p class="hint trg-defence-granted" data-tooltip="Added by effects on this creature (its creature type, abilities, items, conditions). Not typed here, so not saved here: change the effect to change these.">Also from effects: {{defenceGranted.weaknesses}}</p>
          {{/if}}
        </article>
      </div>
    </section>

    <section
      class="tab sheet-tab-panel {{tabs.actions.cssClass}}"
      data-group="primary"
      data-tab="actions"
    >
      <div class="section-heading">
        <div>
          <span class="eyebrow">Universal to every creature — nothing to add or manage here</span>
          <h2>Actions</h2>
        </div>
      </div>

      <article class="ornate-card item-section">
        <h2>Basic Actions</h2>
        <div class="action-grid">
          {{#each basicActions as |action|}}
            <button
              type="button"
              class="action-pill {{action.badge.colorClass}}"
              data-action="useStaticAction"
              data-action-source="basic"
              data-action-key="{{action.key}}"
              data-tooltip="{{action.name}} — {{action.apCost}} AP{{#if action.traits}} ({{action.traits}}){{/if}}: {{action.description}}"
            >
              <span class="action-pill-badge">{{action.badge.label}}</span>
              <span class="action-pill-name">{{action.name}}</span>
            </button>
          {{/each}}
        </div>
      </article>

      <article class="ornate-card item-section">
        <h2>Special Actions</h2>
        <div class="action-grid">
          {{#each specialActions as |action|}}
            <button
              type="button"
              class="action-pill {{action.badge.colorClass}}"
              data-action="useStaticAction"
              data-action-source="special"
              data-action-key="{{action.key}}"
              data-tooltip="{{action.name}} — {{action.apCost}} AP{{#if action.traits}} ({{action.traits}}){{/if}}: {{action.description}}"
            >
              <span class="action-pill-badge">{{action.badge.label}}</span>
              <span class="action-pill-name">{{action.name}}</span>
            </button>
          {{else}}
            <div class="empty-state">
              <i class="fa-solid fa-wind"></i>
              <p>None available — Special Actions require a matching movement type or ability (a fly or burrow speed, for example).</p>
            </div>
          {{/each}}
        </div>
      </article>

      <article class="ornate-card">
        <p class="hint">Skill Actions — including General Skill Actions usable with several skills — appear as an option when you roll the relevant skill on the Skills tab, rather than listed here.</p>
      </article>
    </section>

    <section
      class="tab sheet-tab-panel {{tabs.skills.cssClass}}"
      data-group="primary"
      data-tab="skills"
    >
      <div class="section-heading">
        <div>
          <span class="eyebrow">Training and expertise</span>
          {{!-- The full breakdown is a TOOLTIP on the heading now: it is
                reference, not something to read every time the tab is
                opened. What stays on the page is the tally, which is the
                number a player is actually working against. --}}
          <h2{{#if system.progression}} class="has-detail" data-tooltip="{{skillPointsDetail}}"{{/if}}>Skills</h2>
          {{#if system.progression.skillBudget}}
            <p class="hint skill-budget{{#if system.progression.skillBudget.overspent}} overspent{{/if}}">
              <strong>{{system.progression.skillBudget.spent}}</strong> of
              <strong>{{system.progression.skillBudget.available}}</strong> skill points spent —
              {{#if system.progression.skillBudget.overspent}}
                <strong>{{system.progression.skillBudget.over}} OVER BUDGET</strong>
                — remove {{system.progression.skillBudget.overLabel}}
              {{else}}
                <strong>{{system.progression.skillBudget.remaining}}</strong> left
              {{/if}}
            </p>
            {{#if system.progression.skillBudget.hasOverLevel}}
              <p class="hint skill-budget overspent">
                <strong>Over the level cap:</strong>
                {{#each system.progression.skillBudget.overLevel}}
                  {{this.label}} has {{this.ranks}} ranks, maximum {{this.cap}}{{#unless @last}};{{/unless}}
                {{/each}}
              </p>
            {{/if}}
          {{/if}}
        </div>
        <button type="button" class="gold-button" data-action="rollAidAnother">
          <i class="fa-solid fa-hands-helping"></i> Aid Another
        </button>
        {{#if studiedTargets}}
          <button type="button" class="gold-button" data-action="manageStudiedTargets"
            title="Study Target capacity = Int + level + one per 5 combined knowledge ranks. Click to view and forget studied targets.">
            <i class="fa-solid fa-book-open-reader"></i> Studied Targets ({{studiedTargets.used}}/{{studiedTargets.capacity}})
          </button>
        {{/if}}
        {{#if skillSpecialties}}
          <button type="button" class="gold-button" data-action="manageSkillSpecialties"
            title="Artistry, Crafting and Perform each require a specialty for their trained checks. Click to choose them.">
            <i class="fa-solid fa-palette"></i> Specialties
          </button>
        {{/if}}
        {{#if earnIncomeTask}}
          <button type="button" class="gold-button" data-action="manageEarnIncome"
            title="Active Earn Income task — work another day or finish it.">
            <i class="fa-solid fa-coins"></i> Earn Income ({{earnIncomeTask.totalEarned}} gp, day {{earnIncomeTask.daysWorked}})
          </button>
        {{/if}}
        {{#if createProject}}
          <button type="button" class="gold-button" data-action="manageCreateProject"
            title="Current crafting project — work another day, or clear it.">
            <i class="fa-solid fa-hammer"></i> Crafting: {{createProject.itemName}} ({{createProject.progress}}/{{createProject.itemValue}} gp)
          </button>
        {{/if}}
        {{#if editable}}
          <button type="button" class="gold-button" data-action="skillCreate">
            <i class="fa-solid fa-plus"></i> Add Skill
          </button>
        {{/if}}
      </div>

      {{#if skillSpecialties}}
        <div class="skill-specialties-summary" style="display:flex;flex-wrap:wrap;gap:6px 16px;margin:0 0 8px;font-size:0.85em">
          {{#each skillSpecialties as |spec|}}
            <span><strong>{{spec.label}} specialties</strong> ({{spec.used}}/{{spec.cap}}): {{spec.summary}}</span>
          {{/each}}
        </div>
      {{/if}}

      <div class="skills-scroll">
      <div class="skills-table ornate-table">
        <div class="skill-row skill-header">
          <span>Skill</span>
          <span>Attribute</span>
          <span>Ranks</span>
          <span>Class</span>
          <span>Racial</span>
          <span>Item</span>
          <span>Status</span>
          <span>Other</span>
          <span>Total</span>
          <span>DC</span>
          <span></span>
        </div>
        {{#each skills as |skill|}}
          <div class="skill-row" data-skill-key="{{skill.key}}">
            <button type="button" data-action="rollSkill" data-skill="{{skill.key}}">
              <i class="fa-solid fa-dice-d20"></i>
              {{#if skill.core}}
                <span class="skill-name">{{skill.label}}</span>
              {{else}}
                <input
                  type="text"
                  name="system.skills.{{skill.key}}.label"
                  value="{{skill.label}}"
                  aria-label="Skill name"
                >
              {{/if}}
            </button>
            <select
              name="system.skills.{{skill.key}}.ability"
              aria-label="{{skill.label}} attribute"
            >
              {{selectOptions ../abilityChoices selected=skill.ability}}
            </select>
            <input
              type="number"
              class="skill-ranks{{#if skill.overLevel}} over-level{{/if}}"
              name="system.skills.{{skill.key}}.ranks"
              value="{{skill.ranks}}"
              min="0"
              max="{{../system.identity.level}}"
              data-tooltip="{{#if skill.overLevel}}{{skill.ranks}} ranks, but your level allows only {{../system.identity.level}}. Lower it.{{else}}Ranks can never exceed your character level ({{../system.identity.level}}).{{/if}}"
              aria-label="{{skill.label}} ranks"
            >
            {{! The Class column is a tickbox now, not a number. It used to
                mean two different things at once: "this is a class skill,
                worth my class bonus" and "something granted a flat
                class-type bonus here". The tick is the first; the second
                lives in the effect that granted it and stacks on top. }}
            <label class="class-skill-cell" data-tooltip="{{#if skill.classSkillTooltip}}{{skill.classSkillTooltip}}{{else}}Tick if this is a class skill — it is then worth your class bonus. Your class and any archetype that grants one tick their own.{{/if}}">
              {{! Ticked from the DERIVED state, not the stored one: a
                  Fighter's Athletics is a class skill whether or not the
                  player ever ticked the box, and showing it empty and
                  greyed read as "not a class skill". A disabled control
                  is not submitted, so nothing is written back. }}
              <input
                type="checkbox"
                name="system.skills.{{skill.key}}.classSkill"
                {{checked skill.isClassSkill}}
                {{#if skill.classSkillLocked}}disabled{{/if}}
                aria-label="{{skill.label}} is a class skill"
              >
              {{#if skill.isClassSkill}}<span class="class-skill-value">+{{skill.classSkillValue}}</span>{{/if}}
              {{! A flat class-type bonus from a feat lands in the old
                  numeric slot and still counts. Shown when it is not zero,
                  because otherwise there is now no control on the sheet
                  that reveals it at all. }}
              {{#if skill.class}}<span class="class-skill-flat" data-tooltip="A flat class bonus granted by a feat or effect, on top of any class skill. Stacks, per Appendix 1.">+{{skill.class}}</span>{{/if}}
            </label>
            <input
              type="number"
              name="system.skills.{{skill.key}}.racial"
              value="{{skill.racial}}"
              aria-label="{{skill.label}} racial bonus"
            >
            <input
              type="number"
              name="system.skills.{{skill.key}}.item"
              value="{{skill.item}}"
              aria-label="{{skill.label}} item bonus"
            >
            <input
              type="number"
              name="system.skills.{{skill.key}}.status"
              value="{{skill.status}}"
              aria-label="{{skill.label}} status bonus"
            >
            <input
              type="number"
              name="system.skills.{{skill.key}}.other"
              value="{{skill.other}}"
              aria-label="{{skill.label}} other bonus"
            >
            <output data-tooltip="{{skill.tooltip}}">{{skill.total}}</output>
            <output>{{skill.dc}}</output>
            {{#if ../editable}}
              {{#unless skill.core}}
                <button
                  type="button"
                  class="icon-button danger"
                  data-action="skillDelete"
                  data-tooltip="Delete {{skill.label}}"
                >
                  <i class="fa-solid fa-trash"></i>
                </button>
              {{/unless}}
            {{/if}}
          </div>
        {{/each}}
      </div>
      </div>

      <div class="section-heading specialist-heading">
        <div>
          <span class="eyebrow">Unique training and lore</span>
          <h2>Specialist Skills</h2>
        </div>
        {{#if editable}}
          <button type="button" class="gold-button" data-action="specialistSkillCreate">
            <i class="fa-solid fa-plus"></i> Add Specialist Skill
          </button>
        {{/if}}
      </div>

      <div class="skills-scroll">
      <div class="specialist-skills-table ornate-table">
        <div class="specialist-skill-row skill-header">
          <span>Specialist Skill</span>
          <span>Attribute</span>
          <span>Level</span>
          <span>Class</span>
          <span>Racial</span>
          <span>Item</span>
          <span>Status</span>
          <span>Other</span>
          <span>+2</span>
          <span>Total</span>
          <span>DC</span>
          <span></span>
        </div>
        {{#each specialistSkills as |skill|}}
          <div
            class="specialist-skill-row"
            data-specialist-key="{{skill.key}}"
          >
            <button
              type="button"
              data-action="rollSpecialistSkill"
              data-specialist="{{skill.key}}"
            >
              <i class="fa-solid fa-dice-d20"></i>
              <input
                type="text"
                name="system.specialistSkills.{{skill.key}}.label"
                value="{{skill.label}}"
                aria-label="Specialist skill name"
              >
            </button>
            <select name="system.specialistSkills.{{skill.key}}.ability">
              {{selectOptions ../abilityChoices selected=skill.ability}}
            </select>
            <output>{{../system.identity.level}}</output>
            <output>{{skill.class}}</output>
            <input
              type="number"
              name="system.specialistSkills.{{skill.key}}.racial"
              value="{{skill.racial}}"
            >
            <input
              type="number"
              name="system.specialistSkills.{{skill.key}}.item"
              value="{{skill.item}}"
            >
            <input
              type="number"
              name="system.specialistSkills.{{skill.key}}.status"
              value="{{skill.status}}"
            >
            <input
              type="number"
              name="system.specialistSkills.{{skill.key}}.other"
              value="{{skill.other}}"
            >
            <output>2</output>
            <output data-tooltip="{{skill.tooltip}}">{{skill.total}}</output>
            <output>{{skill.dc}}</output>
            {{#if ../editable}}
              <button
                type="button"
                class="icon-button danger"
                data-action="specialistSkillDelete"
                data-tooltip="Delete {{skill.label}}"
              >
                <i class="fa-solid fa-trash"></i>
              </button>
            {{/if}}
          </div>
        {{else}}
          <div class="empty-state compact">
            <p>No specialist skills have been granted.</p>
          </div>
        {{/each}}
      </div>
      </div>
    </section>

    <section
      class="tab sheet-tab-panel {{tabs.features.cssClass}}"
      data-group="primary"
      data-tab="features"
    >
      <div class="section-heading">
        <div>
          <span class="eyebrow">Talents, training, and bloodlines</span>
          <h2>Feats & Abilities</h2>
        </div>
        {{#if editable}}
          <div class="button-group">
            <button type="button" class="gold-button" data-action="itemCreate" data-item-type="feat">
              <i class="fa-solid fa-plus"></i> Feat
            </button>
            <button type="button" class="gold-button" data-action="itemCreate" data-item-type="ability">
              <i class="fa-solid fa-plus"></i> Ability
            </button>
          </div>
        {{/if}}
      </div>

      <div class="feat-picks-banner">
        {{#if isFamiliar}}
          <span><strong>Familiar Abilities:</strong> {{familiarAbilities.spent}} / {{familiarAbilities.available}}</span>
          <span class="hint">Two at 1st level and one more at 4th and every 4 levels after. Empathic Link is free and costs none of them. A familiar gains no feats of its own.</span>
        {{else if isCompanion}}
          <span><strong>Companion Feats:</strong> {{featPicks.single.spent}} / {{featPicks.single.available}}</span>
          <span class="hint">Spent / Available, from the Animal Companion table's own Feats column — one pool, not the character split. Feats your class granted (Evasion, Improved Evasion) cost nothing.</span>
        {{else}}
          <span><strong>Racial:</strong> {{featPicks.racial.spent}} / {{featPicks.racial.available}}</span>
          <span><strong>Class:</strong> {{featPicks.class.spent}} / {{featPicks.class.available}}</span>
          <span><strong>General:</strong> {{featPicks.general.spent}} / {{featPicks.general.available}}</span>
          {{#if featPicks.archetype}}
            <span><strong>Bonus Archetype:</strong> {{featPicks.archetype.spent}} / {{featPicks.archetype.available}}</span>
          {{/if}}
          <span class="hint">Spent / Available, by character level (Chapter 5). Archetype feats draw from the Class pool{{#if featPicks.archetype}}, after the bonus Archetype pick{{/if}}.{{#if featPicks.extraLabels}} Campaign: {{#each featPicks.extraLabels}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}.{{/if}}</span>
        {{/if}}
      </div>

      <div class="features-columns">
        <div class="features-column">
          <article class="ornate-card item-section compact-feature-card">
            <div class="compact-feature-heading">
