<div class="trg-prime-sheet actor-sheet party-sheet">
  <header class="sheet-header">
    <div class="portrait-frame">
      <img class="profile-img" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-tooltip="Click to change portrait">
    </div>
    <div class="identity">
      <div class="title-row">
        <div class="name-field">
          <span class="eyebrow">Party</span>
          <input class="actor-name" type="text" name="name" value="{{actor.name}}" placeholder="Party Name" {{#unless isGM}}disabled{{/unless}}>
        </div>
        <div class="level-seal">
          <label>Members</label>
          <span class="party-count">{{memberCount}}</span>
        </div>
      </div>
    </div>
  </header>

  {{!-- THE PARTY ACTIONS TOOLBAR (3.709.0, Stage 2): on every tab. Only controls with a
        working system behind them; Rest, Travel and Award XP join in Stage 3. --}}
  <div class="party-toolbar" role="toolbar" aria-label="Party actions">
    {{!-- In the order of PARTY_TOOLBAR_ACTIONS (party-actions.mjs). --}}
    {{#if toolbar.show.rollPartyInitiative}}
    <button type="button" data-player-ok data-action="rollPartyInitiative" data-tooltip="{{toolbar.initiativeHint}}" {{#unless toolbar.partyInitiative}}disabled{{/unless}}>
      <i class="fa-solid fa-dice-d20"></i> Roll Initiative{{#if toolbar.partyInitiative}} ({{toolbar.partyInitiative}}){{/if}}
    </button>
    {{/if}}
    {{#if isGM}}
      {{#if toolbar.show.partyRest}}
      <button type="button" data-action="partyRest" data-tooltip="Rest this party's members only: the Rest dialog, with each eligible member listed once.">
        <i class="fa-solid fa-bed"></i> Rest
      </button>
      {{/if}}
      {{#if toolbar.show.partyTravel}}
      <button type="button" data-action="partyTravel" data-tooltip="Travel with this party's members only: the slowest land Speed sets the pace.">
        <i class="fa-solid fa-person-hiking"></i> Travel
      </button>
      {{/if}}
      {{#if toolbar.show.groupCheck}}
      <button type="button" data-action="groupCheck" data-tooltip="Group Check: each chosen member rolls their own skill check, and the card lists every result. The rules set no group result.">
        <i class="fa-solid fa-people-group"></i> Group Check
      </button>
      {{/if}}
      {{#if toolbar.show.beginSession}}
      <button type="button" data-action="beginSession" data-tooltip="Hero's Resolve: each member with the feat regains a conviction point at the beginning of each game session.">
        <i class="fa-solid fa-sun"></i> Begin Session
      </button>
      {{/if}}
      {{#if toolbar.show.partyAwardXP}}
      <button type="button" data-action="partyAwardXP" data-tooltip="Award XP to this party: the encounter, an accomplishment or a custom amount. You see the split before anything is written.">
        <i class="fa-solid fa-trophy"></i> Award XP
      </button>
      {{/if}}
    {{/if}}
  </div>

  {{!-- Foundry's own tabs (3.708.0): the "tab" action and the "tabs" class are what changeTab looks for. --}}
  <nav class="sheet-tabs tabs" data-group="primary" role="tablist" aria-label="Party sheet tabs">
    {{#each tabList as |tab|}}
      <button type="button" class="sheet-tab {{tab.cssClass}}" data-action="tab" data-player-ok
              data-group="primary" data-tab="{{tab.id}}" data-tooltip="{{tab.label}}"
              role="tab" aria-selected="{{tab.active}}">
        <i class="{{tab.icon}}"></i><span>{{tab.label}}</span>
      </button>
    {{/each}}
  </nav>

  <main class="sheet-body">

    {{!-- ---------------------------------------------------------- --}}
    {{!-- ROSTER                                                      --}}
    {{!-- ---------------------------------------------------------- --}}
    <section class="tab sheet-tab-panel {{tabs.roster.cssClass}}" data-group="primary" data-tab="roster">

      {{!-- THE PARTY SUMMARY (3.709.0, Stage 2). Each figure is an existing rule:
            APL (Chapter 12), the slowest land Speed (the travel rule), coin in gp. --}}
      <div class="party-summary" aria-label="Party summary">
        <div class="party-summary-stat" data-tooltip="Members on the roster that resolved{{#if summary.npcs}}, {{summary.npcs}} of them NPCs{{/if}}">
          <span class="party-summary-label">Members</span><strong>{{summary.members}}</strong>
          {{#if summary.missing}}<span class="party-summary-warn" data-tooltip="Roster entries that could not be found">{{summary.missing}} missing</span>{{/if}}
          {{#if summary.ineligible}}<span class="party-summary-warn" data-tooltip="Roster entries that may not be party members">{{summary.ineligible}} not allowed</span>{{/if}}
        </div>
        <div class="party-summary-stat" data-tooltip="Average Party Level: the average of the members' levels, rounded (Chapter 12){{#if summary.hidden}}. Members you cannot inspect are not counted{{/if}}">
          <span class="party-summary-label">APL</span><strong>{{summary.apl.apl}}</strong>
          {{#if summary.apl.members}}<span class="hint">{{summary.apl.exact}}</span>{{/if}}
        </div>
        <div class="party-summary-stat" data-tooltip="The slowest land Speed sets the party's pace{{#if summary.pacedBy}}: {{summary.pacedBy}}{{/if}}{{#if summary.hidden}}. Members you cannot inspect are not counted{{/if}}">
          <span class="party-summary-label">Pace</span><strong>{{#if summary.speed}}{{summary.speed}} ft{{else}}&mdash;{{/if}}</strong>
          {{#if summary.pacedBy}}<span class="hint">{{summary.pacedBy}}</span>{{/if}}
        </div>
        <div class="party-summary-stat" data-tooltip="The party's shared coin, in gold pieces">
          <span class="party-summary-label">Party Coin</span><strong>{{summary.coinGP}} gp</strong>
        </div>
      </div>

      <article class="ornate-card party-overview">
        <h2><i class="fa-solid fa-users"></i> Members</h2>

        {{#unless hasMembers}}
          <p class="hint party-empty">
            {{#if isGM}}Drag a character or NPC from the sidebar onto this sheet to add them.
            {{else}}The GM has not added anyone to this party yet.{{/if}}
          </p>
        {{/unless}}
        {{#if isGM}}{{#if hasUnresolved}}
          <p class="hint party-unresolved"><i class="fa-solid fa-triangle-exclamation"></i>
            Some roster entries could not be shown as members. Each one says why; use <i class="fa-solid fa-user-minus"></i> to remove it.</p>
        {{/if}}{{/if}}

        {{#each members as |m|}}
          <div class="party-member{{#if m.missing}} party-member-missing{{/if}}" data-uuid="{{m.uuid}}">
            {{#if m.missing}}
              {{!-- 3.708.0: missing, unreadable or not allowed on a roster, each with its reason. Kept until the GM removes it. --}}
              {{#if m.img}}<img class="party-member-portrait" src="{{m.img}}" alt="{{m.name}}">{{/if}}
              <div class="party-member-main">
                <span class="party-member-name">{{m.name}}</span>
                <span class="hint">{{m.missingReason}}</span>
              </div>
            {{else if m.restricted}}
              {{!-- An NPC this user may not inspect: name and portrait only (Graham, 22 Nov 2026). --}}
              <img class="party-member-portrait" src="{{m.img}}" alt="{{m.name}}">
              <div class="party-member-main">
                <div class="party-member-head">
                  <span class="party-member-name">{{m.name}}</span>
                  {{#if m.isNPC}}<span class="party-member-tag">NPC</span>{{/if}}
                </div>
              </div>
            {{else}}
              <img class="party-member-portrait" src="{{m.img}}" alt="{{m.name}}"
                   {{#if m.controls.canOpen}}data-action="openMember" data-tooltip="Open {{m.name}}'s sheet"{{/if}}>
              <div class="party-member-main">
                <div class="party-member-head">
                  <span class="party-member-name"{{#if m.controls.canOpen}} data-action="openMember"{{/if}}>{{m.name}}</span>
                  <span class="party-member-level">Level {{m.level}}</span>
                  {{#if m.isNPC}}<span class="party-member-tag">NPC</span>{{/if}}
                  <span class="party-member-identity">{{m.race}} &middot; {{m.class}}</span>
                </div>

                <div class="party-member-body">
                  <div class="party-member-bars">
                    <div class="party-bar-row">
                      <span class="party-bar-label">HP</span>
                      <div class="party-bar" data-tooltip="Hit points {{m.hp.value}} of {{m.hp.max}}{{#if m.hp.temp}}, plus {{m.hp.temp}} temporary{{/if}}"><div class="party-bar-fill party-bar-hp" style="width:{{m.hp.pct}}%"></div></div>
                      <span class="party-bar-value">{{m.hp.value}} / {{m.hp.max}}{{#if m.hp.temp}} <span class="party-temp">+{{m.hp.temp}}</span>{{/if}}</span>
                      {{#if m.controls.gm}}<span class="party-steppers">
                        <button type="button" class="party-step" data-action="stepMemberResource" data-resource="hp" data-delta="-1" data-tooltip="HP −1 (as editing the sheet's field)" aria-label="Lower {{m.name}}'s HP by 1">−</button>
                        <button type="button" class="party-step" data-action="stepMemberResource" data-resource="hp" data-delta="1" data-tooltip="HP +1 (as editing the sheet's field)" aria-label="Raise {{m.name}}'s HP by 1">+</button>
                      </span>{{/if}}
                    </div>
                    <div class="party-bar-row">
                      <span class="party-bar-label">PP</span>
                      <div class="party-bar" data-tooltip="Power points {{m.pp.value}} of {{m.pp.max}}"><div class="party-bar-fill party-bar-pp" style="width:{{m.pp.pct}}%"></div></div>
                      <span class="party-bar-value">{{m.pp.value}} / {{m.pp.max}}</span>
                      {{#if m.controls.gm}}<span class="party-steppers">
                        <button type="button" class="party-step" data-action="stepMemberResource" data-resource="pp" data-delta="-1" data-tooltip="PP −1" aria-label="Lower {{m.name}}'s PP by 1">−</button>
                        <button type="button" class="party-step" data-action="stepMemberResource" data-resource="pp" data-delta="1" data-tooltip="PP +1" aria-label="Raise {{m.name}}'s PP by 1">+</button>
                      </span>{{/if}}
                    </div>
                  </div>

                  <div class="party-stats" role="list">
                    <span class="party-stat" role="listitem" data-tooltip="Defence Bonus"><label>DB</label><strong>{{#if (eq m.stats.defence null)}}&mdash;{{else}}{{m.stats.defence}}{{/if}}</strong></span>
                    <span class="party-stat" role="listitem" data-tooltip="Initiative bonus"><label>Init</label><strong>{{#if (eq m.stats.initiative null)}}&mdash;{{else}}{{m.stats.initiative}}{{/if}}</strong></span>
                    <span class="party-stat" role="listitem" data-tooltip="Fortitude save"><label>Fort</label><strong>{{#if (eq m.stats.fortitude null)}}&mdash;{{else}}{{m.stats.fortitude}}{{/if}}</strong></span>
                    <span class="party-stat" role="listitem" data-tooltip="Reflex save"><label>Ref</label><strong>{{#if (eq m.stats.reflex null)}}&mdash;{{else}}{{m.stats.reflex}}{{/if}}</strong></span>
                    <span class="party-stat" role="listitem" data-tooltip="Will save"><label>Will</label><strong>{{#if (eq m.stats.will null)}}&mdash;{{else}}{{m.stats.will}}{{/if}}</strong></span>
                    <span class="party-stat" role="listitem" data-tooltip="Land Speed"><label>Speed</label><strong>{{#if m.stats.speed}}{{m.stats.speed}}{{else}}&mdash;{{/if}}</strong></span>
                  </div>

                  <div class="party-resources">
                    {{#each m.resourceList as |r|}}
                      <span class="party-resource" data-tooltip="{{r.label}} {{r.value}} of {{r.max}}">
                        <label>{{r.short}}</label>
                        {{#if m.controls.gm}}<button type="button" class="party-step" data-action="stepMemberResource" data-resource="{{r.key}}" data-delta="-1" data-tooltip="{{r.label}} −1" aria-label="Lower {{m.name}}'s {{r.label}} by 1">−</button>{{/if}}
                        <strong>{{r.value}}/{{r.max}}</strong>
                        {{#if m.controls.gm}}<button type="button" class="party-step" data-action="stepMemberResource" data-resource="{{r.key}}" data-delta="1" data-tooltip="{{r.label}} +1" aria-label="Raise {{m.name}}'s {{r.label}} by 1">+</button>{{/if}}
                      </span>
                    {{/each}}
                  </div>
                </div>

                {{#if (or m.conditionChips.length m.effects.length m.controls.gm)}}
                  <div class="party-conditions">
                    {{#each m.conditionChips as |c|}}
                      {{#if (and m.controls.gm c.removable)}}
                        <button type="button" class="party-condition party-condition-action" data-action="removeMemberCondition" data-condition="{{c.id}}"
                                data-tooltip="{{c.label}} — click to remove">{{c.label}} <i class="fa-solid fa-xmark"></i></button>
                      {{else}}
                        <span class="party-condition{{#if c.granted}} party-condition-granted{{/if}}"{{#if c.granted}} data-tooltip="Granted by another condition"{{/if}}>{{c.label}}</span>
                      {{/if}}
                    {{/each}}
                    {{#each m.effects as |e|}}
                      <span class="party-effect" data-tooltip="Active effect">{{#if e.img}}<img src="{{e.img}}" alt="">{{/if}}{{e.name}}</span>
                    {{/each}}
                    {{#if m.controls.gm}}
                      <button type="button" class="party-condition-add" data-action="addMemberCondition" data-tooltip="Add a condition" aria-label="Add a condition to {{m.name}}"><i class="fa-solid fa-plus"></i></button>
                    {{/if}}
                  </div>
                {{/if}}
              </div>
            {{/if}}

            {{!-- The member's controls. Each is checked again when pressed. --}}
            <div class="party-member-controls">
              {{#unless m.missing}}
                {{#if m.controls.canOpen}}<button type="button" data-player-ok data-action="openMember" data-tooltip="Open sheet" aria-label="Open {{m.name}}'s sheet"><i class="fa-solid fa-id-card"></i></button>{{/if}}
                <button type="button" data-player-ok data-action="findToken" data-tooltip="{{m.controls.find.hint}}" aria-label="Find {{m.name}}'s token" {{#unless m.controls.find.enabled}}disabled{{/unless}}><i class="fa-solid fa-location-crosshairs"></i></button>
                <button type="button" data-player-ok data-action="selectToken" data-tooltip="{{m.controls.select.hint}}" aria-label="Select {{m.name}}'s token" {{#unless m.controls.select.enabled}}disabled{{/unless}}><i class="fa-solid fa-hand-pointer"></i></button>
                {{#unless m.restricted}}
                  {{#if (eq m.controls.initiative.state "rolled")}}
                    <span class="party-init-value" data-tooltip="{{m.controls.initiative.hint}}">{{m.controls.initiative.value}}</span>
                  {{else}}
                    <button type="button" data-player-ok data-action="rollMemberInitiative" data-tooltip="{{m.controls.initiative.hint}}" aria-label="Roll initiative for {{m.name}}" {{#unless m.controls.initiative.enabled}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i></button>
                  {{/if}}
                {{/unless}}
                {{#if m.controls.gm}}<button type="button" data-action="applyMemberDamage" data-tooltip="Apply Damage (Chapter 7)" aria-label="Apply damage to {{m.name}}"><i class="fa-solid fa-heart-crack"></i></button>{{/if}}
              {{/unless}}
              {{!-- ../isGM: inside the each, a bare isGM is read from the member and was always false,
                    so the GM never had this button (found live, 3.708.1). --}}
              {{#if ../isGM}}
                <button type="button" class="party-remove" data-action="removeMember"
                        data-tooltip="Remove from roster" aria-label="Remove {{m.name}} from the roster"><i class="fa-solid fa-user-minus"></i></button>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </article>
    </section>

    {{!-- ---------------------------------------------------------- --}}
    {{!-- SKILLS (3.712.0, Stage 5)                                    --}}
    {{!-- ---------------------------------------------------------- --}}
    <section class="tab sheet-tab-panel {{tabs.skills.cssClass}}" data-group="primary" data-tab="skills">
      <article class="ornate-card">
        <h2><i class="fa-solid fa-list-check"></i> Party Skills</h2>
        <p class="hint">Each member's skill modifier, as their own sheet prints it. Click one to roll that member's check. The highest in each column is marked; "?" is a member whose statistics you cannot see, "—" a skill the member's data does not have.</p>
        <div class="party-inventory-tools">
          <input type="search" data-skill-filter data-player-ok placeholder="Filter skills" value="{{skills.filter}}" aria-label="Filter the skills">
        </div>
        {{#if skills.empty}}
          <p class="hint party-empty">The party has no members to show.</p>
        {{else}}
          <div class="party-skills-scroll">
            <table class="party-skills-table">
              <thead>
                <tr>
                  <th class="party-skills-name">
                    <button type="button" class="party-item-link" data-player-ok data-action="sortSkills" data-tooltip="Sort by name">
                      Member <i class="fa-solid {{#if (eq skills.sort "asc")}}fa-arrow-down-a-z{{else}}fa-arrow-up-z-a{{/if}}"></i>
                    </button>
                  </th>
                  {{#each skills.columns as |c|}}
                    <th data-skill-col="{{c.key}}" {{#unless c.shown}}hidden{{/unless}} scope="col"><span>{{c.label}}</span></th>
                  {{/each}}
                </tr>
              </thead>
              <tbody>
                {{#each skills.rows as |r|}}
                  <tr data-uuid="{{r.uuid}}">
                    <th class="party-skills-name" scope="row">{{#if r.img}}<img src="{{r.img}}" alt="">{{/if}}<span>{{r.name}}</span></th>
                    {{#each r.cells as |cell|}}
                      <td data-skill-col="{{cell.key}}" class="{{#if cell.best}}party-skill-best{{/if}} party-skill-{{cell.state}}" {{#unless cell.shown}}hidden{{/unless}}>
                        {{#if cell.rollable}}
                          <button type="button" class="party-skill-roll" data-player-ok data-action="rollMemberSkill" data-skill="{{cell.key}}" data-tooltip="Roll {{r.name}}'s check">{{cell.text}}</button>
                        {{else}}<span {{#if (eq cell.state "hidden")}}data-tooltip="Hidden"{{/if}}{{#if (eq cell.state "unavailable")}}data-tooltip="Not in this member's data"{{/if}}>{{cell.text}}</span>{{/if}}
                      </td>
                    {{/each}}
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
          <p class="hint party-empty" data-skill-none hidden>No skill matches the filter.</p>
        {{/if}}
      </article>
    </section>

    {{!-- ---------------------------------------------------------- --}}
    {{!-- LOOT                                                        --}}
    {{!-- ---------------------------------------------------------- --}}
    <section class="tab sheet-tab-panel {{tabs.loot.cssClass}}" data-group="primary" data-tab="loot">

      {{!-- UNFINISHED TRANSFERS (3.711.0, Stage 4): the GM's alone. A transfer cut off half-way (a disconnect)
           stays in the party's journal and is shown here until the GM has checked it. --}}
      {{#if inventory.hasPending}}
        <article class="ornate-card party-transfer-pending">
          <h2><i class="fa-solid fa-triangle-exclamation"></i> Unfinished Transfers</h2>
          <p class="hint">These did not finish. Check both inventories, put them right by hand if needed, then mark each one checked.</p>
          <ul class="party-pending-list">
            {{#each inventory.pending as |p|}}
              <li data-transfer-id="{{p.id}}">
                <span><strong>{{p.summary}}</strong>{{#if p.user}} — {{p.user}}{{/if}}, {{p.when}}</span>
                {{#if p.unresolved}}<span class="hint">{{p.unresolved}}</span>{{/if}}
                <button type="button" data-action="resolveTransfer"><i class="fa-solid fa-check"></i> Checked</button>
              </li>
            {{/each}}
          </ul>
        </article>
      {{/if}}

      {{!-- THE TREASURY (Stage 4): balances and value; every movement goes through the GM's client. --}}
      <article class="ornate-card">
        <h2><i class="fa-solid fa-coins"></i> Treasury</h2>
        <div class="party-coin-row">
          {{#each coinKeys as |key|}}
            <div class="party-coin">
              <label>{{key}}</label>
              <input type="number" name="system.currency.{{key}}" value="{{lookup ../currency key}}"
                     min="0" {{#unless ../isGM}}disabled{{/unless}}>
            </div>
          {{/each}}
          <div class="party-coin-total">
            <label>Total value</label>
            <span>{{currencyGP}} gp</span>
          </div>
        </div>
        <div class="party-treasury-actions">
          {{#if treasury.canDeposit}}
            <button type="button" data-player-ok data-action="depositCoin"><i class="fa-solid fa-piggy-bank"></i> Deposit Coin</button>
          {{/if}}
          {{#if treasury.canTake}}
            <button type="button" class="party-take-coin" data-player-ok data-action="takeCoin"><i class="fa-solid fa-hand-holding-dollar"></i> Take Coin</button>
          {{/if}}
          {{#if treasury.canGive}}
            <button type="button" class="party-take-coin" data-action="takeCoin"><i class="fa-solid fa-hand-holding-dollar"></i> Give Coin</button>
          {{/if}}
          {{#if treasury.canSplit}}
            <button type="button" data-action="splitCoin"><i class="fa-solid fa-scale-balanced"></i> Split Coin</button>
          {{/if}}
        </div>
      </article>

      <article class="ornate-card">
        <h2><i class="fa-solid fa-sack-dollar"></i> Party Inventory
          <span class="hint party-loot-total">{{loot.count}} items &middot; {{loot.totalWeight}} lb</span>
        </h2>

        <div class="party-inventory-tools">
          <input type="search" data-inventory-search data-player-ok placeholder="Search by name" value="{{inventory.search}}" aria-label="Search the inventory">
          <select data-inventory-type data-player-ok aria-label="Filter by type">
            <option value="">All types</option>
            {{#each inventory.types as |t|}}<option value="{{t.type}}" {{#if t.selected}}selected{{/if}}>{{t.label}}</option>{{/each}}
          </select>
          {{#if inventory.canDeposit}}
            <button type="button" data-player-ok data-action="depositItem"><i class="fa-solid fa-box-archive"></i> Deposit Item</button>
          {{/if}}
        </div>

        {{!-- THE GM'S DROP TARGETS: drag an item onto a member to give it to them (a move, never a copy). --}}
        {{#if inventory.members.length}}
          <div class="party-drop-strip">
            <span class="hint">Drag an item onto a member to give it:</span>
            {{#each inventory.members as |m|}}
              <div class="party-drop-member" data-drop-member="{{m.uuid}}" data-tooltip="Give to {{m.name}}">
                {{#if m.img}}<img src="{{m.img}}" alt="">{{/if}}<span>{{m.name}}</span>
              </div>
            {{/each}}
          </div>
        {{/if}}

        {{#if loot.empty}}
          <p class="hint party-empty">
            {{#if isGM}}Drag gear, weapons, armour or consumables onto this sheet to add them, or deposit them from a member.
            {{else}}The party has nothing to share right now.{{#if inventory.canDeposit}} Deposit something from your character.{{/if}}{{/if}}
          </p>
        {{else}}
          <table class="party-loot-table party-inventory-table">
            <thead>
              <tr><th>Name</th><th>Type</th><th>Qty</th><th data-tooltip="Weight each / in all">Wt.</th><th>Details</th><th class="party-loot-actions"></th></tr>
            </thead>
            <tbody>
              {{#each loot.rows as |row|}}
                <tr class="loot-row" data-item-id="{{row.id}}" data-type="{{row.type}}" data-name="{{row.name}}">
                  <td class="loot-name">
                    {{#if row.canOpen}}
                      <button type="button" class="party-item-link" data-player-ok data-action="openLootItem" data-tooltip="Open {{row.name}}">
                        <img src="{{row.img}}" alt=""><span>{{row.name}}</span>
                      </button>
                    {{else}}<img src="{{row.img}}" alt=""><span>{{row.name}}</span>{{/if}}
                  </td>
                  <td>{{row.typeLabel}}</td>
                  <td>{{row.quantity}}</td>
                  <td>{{row.weight}}{{#if (gt row.quantity 1)}} / {{row.totalWeight}}{{/if}}</td>
                  <td class="hint">{{row.detail}}</td>
                  <td class="party-loot-actions">
                    {{#if ../inventory.canTake}}
                      <button type="button" data-player-ok data-action="takeItem" data-tooltip="{{#if ../isGM}}Give to a member{{else}}Take this{{/if}}">
                        <i class="fa-solid fa-hand-holding"></i>
                      </button>
                    {{/if}}
                    {{#if ../isGM}}
                      <button type="button" data-action="deleteLoot" data-tooltip="Remove from the inventory">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    {{/if}}
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
          <p class="hint party-empty" data-inventory-none hidden>Nothing matches the search.</p>
        {{/if}}
      </article>
    </section>

    {{!-- ---------------------------------------------------------- --}}
    {{!-- REWARDS (3.619.0; Chapter 12, pages 389-393)                --}}
    {{!-- ---------------------------------------------------------- --}}
    {{!-- The GM's alone (3.708.0): for a player the tab and its context are not built at all. --}}
    {{#if isGM}}
    <section class="tab sheet-tab-panel {{tabs.rewards.cssClass}}" data-group="primary" data-tab="rewards">

      <article class="ornate-card party-rewards">
        <h2><i class="fa-solid fa-dragon"></i> Encounter
          <span class="hint party-loot-total">APL {{rewards.apl.apl}}{{#if rewards.apl.members}} ({{rewards.apl.exact}} across {{rewards.apl.members}}){{/if}}</span>
        </h2>
        <div class="party-encounter-head">
          <label>Threat Level
            <select name="system.encounter.threat" {{#unless isGM}}disabled{{/unless}}>
              {{#each rewards.threatOptions as |t|}}<option value="{{t.key}}" {{#if t.selected}}selected{{/if}}>{{t.label}}</option>{{/each}}
            </select>
          </label>
          <span class="party-encounter-budget">Budget <strong>{{rewards.summary.budget}}</strong> XP &middot; Total <strong>{{rewards.summary.total}}</strong> XP{{#if rewards.summary.over}} <span class="party-over">over budget</span>{{/if}}</span>
        </div>
        {{#if rewards.summary.actualThreat}}<p class="hint">As built, the encounter is <strong>{{rewards.summary.actualThreat}}</strong> for this party.</p>{{/if}}

        {{#if rewards.creatures.length}}
          <table class="party-loot-table party-encounter-table">
            <thead><tr><th>Adversary</th><th>EL</th><th>No.</th><th>XP each</th><th>XP</th><th></th></tr></thead>
            <tbody>
              {{#each rewards.creatures as |c|}}
                <tr data-creature-uuid="{{c.uuid}}">
                  <td class="loot-name">{{#if c.img}}<img src="{{c.img}}" alt="">{{/if}}<span {{#if c.tokens}}data-tooltip="Counted from {{c.tokens}} token{{#if (gt c.tokens 1)}}s{{/if}}"{{/if}}>{{c.name}}</span>
                    {{#if c.beyond}}<span class="party-over" data-tooltip="Effective Level {{c.difference}} from the party's — off Chapter 12's table">beyond the table</span>{{/if}}</td>
                  <td>{{c.el}}</td>
                  <td><input type="number" min="0" value="{{c.count}}" data-encounter-count {{#unless ../isGM}}disabled{{/unless}}></td>
                  <td>{{c.xpEach}}</td>
                  <td>{{c.xp}}</td>
                  <td class="party-loot-actions">{{#if ../isGM}}<button type="button" data-action="removeEncounterCreature" data-tooltip="Remove"><i class="fa-solid fa-trash"></i></button>{{/if}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        {{else}}
          <p class="hint party-empty">{{#if isGM}}With this tab open, drag adversaries (actors or perils) onto the sheet, or select their tokens and add them. Each is worth XP by its Effective Level against the party's (Chapter 12).{{else}}No encounter is being built.{{/if}}</p>
        {{/if}}

        {{#if isGM}}
          <div class="party-reward-buttons">
            <button type="button" data-action="importCombat" data-tooltip="Import the adversaries of the active combat, or another you choose. Party members are left out."><i class="fa-solid fa-shield-halved"></i> Import Combat</button>
            <button type="button" data-action="addSelectedTokens" data-tooltip="Import the selected tokens' creatures. Party members are left out."><i class="fa-solid fa-crosshairs"></i> Add Selected Tokens</button>
            <button type="button" data-action="clearEncounter" data-tooltip="Empty this list. No actor, token or combat is deleted."><i class="fa-solid fa-eraser"></i> Clear</button>
            <button type="button" data-action="awardEncounterXP" {{#unless rewards.summary.total}}disabled{{/unless}}>
              <i class="fa-solid fa-trophy"></i> Award {{rewards.summary.total}} XP ({{rewards.split.each}} each)
            </button>
          </div>
        {{/if}}
      </article>

      <article class="ornate-card">
        <h2><i class="fa-solid fa-star"></i> Accomplishments</h2>
        <p class="hint">Split evenly across the party (Chapter 12).</p>
        {{#if isGM}}
          <div class="party-reward-buttons">
            {{#each rewards.accomplishments as |a|}}
              <button type="button" data-action="awardAccomplishment" data-award="{{a.key}}">{{a.label}} {{a.xp}}</button>
            {{/each}}
          </div>
          <div class="party-reward-buttons">
            <input type="number" min="1" placeholder="XP" data-custom-xp>
            <button type="button" data-action="awardCustomXP"><i class="fa-solid fa-gift"></i> Award</button>
          </div>
        {{/if}}
      </article>

      <article class="ornate-card">
        <h2><i class="fa-solid fa-gem"></i> Treasure by Level</h2>
        {{#if rewards.treasure}}
          <p>A party of APL {{rewards.treasure.apl}} would expect about <strong>{{rewards.treasure.gp}} gp</strong> of total wealth and <strong>{{rewards.treasure.items}} magic items</strong>.</p>
        {{else}}
          <p class="hint">First-level characters start with the wealth from Chapter 6; the guide begins at APL 2.</p>
        {{/if}}
        <p class="hint">A guide for the GM only (Chapter 12) — nothing here is counted or enforced.</p>
      </article>

      {{#if isGM}}
        <article class="ornate-card">
          <h2><i class="fa-solid fa-dice-d20"></i> Session</h2>
          <button type="button" data-action="beginSession" data-tooltip="Hero's Resolve: each member with the feat regains a conviction point at the beginning of each game session.">
            <i class="fa-solid fa-sun"></i> Begin Session
          </button>
        </article>
      {{/if}}
    </section>
    {{/if}}

    {{!-- ---------------------------------------------------------- --}}
    {{!-- NOTES (3.712.0, Stage 5): system.details.notes, shared      --}}
    {{!-- ---------------------------------------------------------- --}}
    <section class="tab sheet-tab-panel {{tabs.notes.cssClass}}" data-group="primary" data-tab="notes">
      <article class="ornate-card party-notes">
        <h2><i class="fa-solid fa-book-open"></i> Party Notes</h2>
        {{#if notes.editable}}
          <p class="hint">Shared with everyone who can see this party. Players read them; the GM edits. A secret block is shown to the GM only on this sheet, but the text is still stored in the party, so keep true secrets elsewhere.</p>
          <prose-mirror name="system.details.notes" value="{{notes.raw}}" toggled>{{{notes.html}}}</prose-mirror>
        {{else}}
          {{#if notes.empty}}<p class="hint party-empty">No notes yet.</p>{{else}}<div class="party-notes-view">{{{notes.html}}}</div>{{/if}}
        {{/if}}
      </article>
    </section>
  </main>
</div>
